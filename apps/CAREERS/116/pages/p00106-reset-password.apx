page 106 (
    name: Reset Password
    alias: RESET-PASSWORD
    title: "&{RESET_PASSWORD}."
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .no-border-item input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                pointer-events: none;
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
            }
            
            body {
                background-image: url("#APP_FILES#CareerBackGround4.jpg");
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region reset-password (
        name: Reset Password
        title: "&{RESET_PASSWORD}."
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P106_ACC_ID (
        type: hidden
        layout {
            sequence: 50
            region: @reset-password
            slot: regionBody
        }
    )

    pageItem P106_CONFIRM_NEW_PASSWORD (
        type: password
        label {
            label: "&{CONFIRM_PASSWORD}."
            alignment: left
        }
        layout {
            sequence: 40
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P106_EMAIL (
        type: textField
        label {
            label: "&{EMAIL}."
            alignment: left
        }
        layout {
            sequence: 10
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNull
            item: P106_ACC_ID
        }
    )

    pageItem P106_NEW_PASSWORD (
        type: password
        label {
            label: "&{NEW_PASSWORD}."
            alignment: left
        }
        layout {
            sequence: 20
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button reset-password-btn (
        buttonName: Reset_Password_Btn
        label: "&{RESET_PASSWORD}."
        layout {
            sequence: 60
            region: @reset-password
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process reset-password (
        name: Reset Password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    user_account_package.Reset_password(:P106_NEW_PASSWORD, :P106_ACC_ID);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "&{THE_PASSWORD_UPDATED_SUCCESSFULLY}."
        }
        advanced {
            executionMappingIdentifier: 315101300077516341
        }
        serverSideCondition {
            whenButtonPressed: @reset-password-btn
            type: itemIsNotNull
            item: P106_ACC_ID
        }
    )

    process reset-password_1 (
        name: Reset Password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    user_account_package.Reset_password_Current_User(:P106_EMAIL, :P106_NEW_PASSWORD);
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: "&{THE_PASSWORD_UPDATED_SUCCESSFULLY}."
        }
        advanced {
            executionMappingIdentifier: 30349935184074605
        }
        serverSideCondition {
            whenButtonPressed: @reset-password-btn
            type: itemIsNull
            item: P106_ACC_ID
        }
    )

    branch (
        name: login redirect
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
                action: resetRegions
            }
        }
    )

)
