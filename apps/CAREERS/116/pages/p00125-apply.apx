    dynamicAction add-certificate (
        name: Add certificate
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @other-certificates-for-person
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @other-certificates-for-person
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        config {
            buildOption: @commented-out
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_id       NUMBER;
                        l_ischeck  NUMBER;
                    BEGIN
                    
                        SELECT id
                        INTO l_id
                        FROM account
                        WHERE email = :APP_USER;
                    
                        SELECT COUNT(*)
                        INTO l_ischeck
                        FROM job_application ja
                        JOIN job_vacancy_application jva
                            ON ja.id = jva.application_id
                        WHERE jva.vacancy_id = :P125_VACANCY_ID
                          AND ja.account_id = l_id;
                    
                        IF l_ischeck > 0 THEN
                            :P125_PAGE_FLAG := 'Y';
                        ELSE
                            :P125_PAGE_FLAG := 'N';
                        END IF;
                    
                    END;
                    ```
                itemsToSubmit: P125_PAGE_FLAG
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var btn = apex.item("SUBMIT_BUTTON");
                    
                    if ($v("P125_PAGE_FLAG") === "Y") {
                        btn.disable();
                    } else {
                        btn.enable();
                    }
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

    validation c-date (
        name: C_Date
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P125_DATE_OF_ACQUISITION
        }
        error {
            errorMessage: "&{DATE_IS_REQUIRED}."
        }
        config {
            buildOption: @commented-out
        }
    )

    validation c-name (
        name: C_name
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P125_CERTIFICATE_NAME
        }
        error {
            errorMessage: "&{CERTIFICATE_NAME_IS_REQUIRED}."
        }
        config {
            buildOption: @commented-out
        }
    )

    validation resume (
        name: Resume
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P125_RESUME
        }
        error {
            errorMessage: "&{RESUME_IS_REQUIRED}."
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process check-job-vacancy (
        name: Check_job_vacancy
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P125_JOB_VACANCY_CHECK := Job_application_pkg.check_application_vacancy(:P125_PERSONAL_ID, :P125_VACANCY_ID);
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 351443528476669613
        }
    )

    process check-vacancy-id (
        name: Check vacancy id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    if :P125_VACANCY_ID is null then
                        raise_application_error(-20101, 'choose the job');
                    end if; 
                end;
                 
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 351443168743669613
        }
    )

    process clear-certificates (
        name: Clear Certificates
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                
                    apex_collection.delete_collection('CERTIFICATES');
                
                
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 351442796671669612
        }
        serverSideCondition {
            whenButtonPressed: @clear
        }
    )

    process get-vacancy-details (
        name: get_vacancy_details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                
                    select jv.title, jv.summary, jv.RESPONSIBILITIES, jv.QUALIFICATIONS, eduL.name as education_level 
                    into :P125_JOB_TITLE ,:P125_JOB_SUMMARY
                    , :P125_RESP, :P125_QUALIFICATIONS, :P125_EDUCATION_LEVEL from JOB_VACANCY jv
                    join education_level eduL on eduL.id = jv.MINIMUM_EDUCATION_LEVEL_ID
                    where jv.id = :P125_VACANCY_ID;
                 
                
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 35282063850981436
        }
    )

    process initialize-form-apply-test (
        name: Initialize form Apply test
        type: formInitialization
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 351436993690669599
        }
        config {
            buildOption: @commented-out
        }
    )

    process send-email (
        name: Send_Email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- declare
                --     v_email varchar2(200);
                --     v_first_name varchar2(200);
                
                -- begin
                
                --     select email, FIRST_NAME into v_email, v_first_name from account where id = :APP_USER_ACC_ID;
                
                --      -- send email
                --     APEX_MAIL.SEND(
                --         p_to   => v_email,
                --         p_from => 'apex@eprom.com.eg',
                --         p_subj => 'Job Application is submitted',
                --         p_body => 'MR ' || v_first_name || ' ' || 'Job Application is submitted'
                --     );
                
                --     APEX_MAIL.PUSH_QUEUE;
                
                -- end;
                
                
                DECLARE
                    v_first_name VARCHAR2(200);
                BEGIN
                    SELECT email, first_name
                    INTO :P125_EMAIL, v_first_name
                    FROM account
                    WHERE id = :APP_USER_ACC_ID;
                
                    APEX_MAIL.SEND(
                        p_to   => :P125_EMAIL,
                        p_from => 'apex@eprom.com.eg',
                        p_subj => 'Job Application Submitted',
                        p_body => 'Dear Mr. ' || v_first_name || ',' || chr(10) || chr(10) ||
                                  'Your job application has been submitted successfully.' || chr(10) ||
                                  'Thank you for applying.'
                    );
                
                    APEX_MAIL.PUSH_QUEUE;
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL; -- or raise an application error
                END;
                
                
                -- BEGIN
