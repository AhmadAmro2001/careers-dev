    button add-certificate (
        buttonName: Add_Certificate
        label: "&{ADD_CERTIFICATE}."
        layout {
            sequence: 20
            region: @other-certificates-for-person
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 127
                items: {
                    P127_VACANCY_ID: &P125_VACANCY_ID.
                }
            }
        }
    )

    button clear (
        buttonName: Clear
        label: "&{CLEAR}."
        layout {
