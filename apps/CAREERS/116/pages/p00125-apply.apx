page 125 (
    name: Apply
    alias: APPLY
    title: "&{APPLY}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            
            /* ========================================================== */
            /* CUSTOM NAVBAR                                               */
            /* ========================================================== */
            
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            
                background: rgb(233, 233, 233);
            
                padding: 14px 24px;
            
                border-radius: 18px;
            
                box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            
                margin-bottom: 20px;
            }
            
            /* Left Links */
            .nav-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            
            /* Nav Links */
            .nav-link {
                display: flex;
                align-items: center;
                gap: 8px;
            
                text-decoration: none;
            
                color: #334155;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Hover */
            .nav-link:hover {
                background: rgb(232, 244, 255);
                color: #0563bb;
            }
            
            /* Logout Button */
            .logout-btn {
                display: flex;
                align-items: center;
                gap: 8px;
            
                background: #ef4444;
            
                color: white !important;
            
                text-decoration: none;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Logout Hover */
            .logout-btn:hover {
                background: #dc2626;
                transform: translateY(-1px);
            }
            
            /* Icons */
            .custom-navbar .fa {
                font-size: 14px;
            }
            
            .nav-right {
                display: flex;
                align-items: center;
                gap: 15px;
            }
            
            .user-name {
                color: #333;
                font-weight: 600;
            }
            
            /* Make navbar wrap on small screens */
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap; /* مهم جداً */
            }
            
            /* Mobile & small tablets */
            @media (max-width: 768px) {
                .custom-navbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 12px;
                }
            
                .nav-left,
                .nav-right {
                    width: 100%;
                    justify-content: flex-start;
                    flex-wrap: wrap;
                }
            
                .nav-link,
                .logout-btn {
                    width: 100%;
                    justify-content: center;
                }
            
                .user-name {
                    width: 100%;
                    text-align: left;
                }
            }
            
            /* Very small screens (phones) */
            @media (max-width: 480px) {
                .nav-link,
                .logout-btn {
                    padding: 12px;
                    font-size: 14px;
                }
            
                .custom-navbar {
                    padding: 12px;
                }
            }
            
            
            
            /* Style all job detail regions */
            #job-summary,
            #project-description,
            #responsibilities,
            #qualifications,
            #benefits,
            #skills{
            
                background:#ffffff;
                border-left:6px solid #1565C0;
                border-radius:18px;
                padding:30px;
                margin-bottom:30px;
            
                box-shadow:0 8px 20px rgba(0,0,0,.08);
            
                transition:.3s;
            }
            
            /* Hover effect */
            #job-summary:hover,
            #project-description:hover,
            #responsibilities:hover,
            #qualifications:hover,
            #benefits:hover,
            #skills:hover{
            
                transform:translateY(-3px);
                box-shadow:0 12px 28px rgba(0,0,0,.12);
            
            }
            
            #job-summary .t-Region-title,
            #project-description .t-Region-title,
            #responsibilities .t-Region-title,
            #qualifications .t-Region-title,
            #benefits .t-Region-title,
            #skills .t-Region-title{
            
                color:#1565C0;
                font-size:28px;
                font-weight:700;
                text-align:center;
                text-transform:uppercase;
                letter-spacing:1px;
            }
            
            
            #job-summary .t-Region-title::after,
            #project-description .t-Region-title::after,
            #responsibilities .t-Region-title::after,
            #qualifications .t-Region-title::after,
            #benefits .t-Region-title::after,
            #skills .t-Region-title::after{
            
                content:"";
                display:block;
                width:80px;
                height:4px;
                background:#1565C0;
                margin:12px auto 0;
                border-radius:5px;
            
            }
            
            
            #job-summary,
            #project-description,
            #responsibilities,
            #qualifications,
            #benefits,
            #skills{
            
                font-size:16px;
                color:#444;
                line-height:1.9;
                font-family:"Segoe UI",sans-serif;
            
            }
            
            
            .no-word-break {
                white-space: normal !important;
                word-break: keep-all !important;
                overflow-wrap: normal !important;
                word-wrap: normal !important;
                hyphens: manual !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region apply-reg (
        name: apply_reg
        title: Apply
        type: staticContent
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            column: 8
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region job-summary (
        name: Job_summary
        title: "&{JOB_DETAILS}."
        type: staticContent
        layout {
            sequence: 30
            slot: body
            column: 2
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: job-summary
        }
    )

    region navbar (
        name: navbar
        title: "&{NAVBAR}."
        type: appTemplateComponent/appliocantNavbar
        layout {
            sequence: 10
            slot: body
            column: 2
            columnSpan: 10
        }
        componentAppearance {
            display: regionOnly
        }
        settings {
            personalCheck: &PERSONAL_CHECK.
        }
    )

    region other-certificates-for-person (
        name: Other certificates for person
        title: "&{YOUR_CERTIFICATES}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    seq_id,
                    c001 AS certificate_name,
                    d001 AS certificate_date
                FROM apex_collections
                WHERE collection_name = 'CERTIFICATES'
                ```
        }
        layout {
            sequence: 60
            parentRegion: @apply-reg
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Enter Your Certificates
        }

        column CERTIFICATE_DATE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: "&{CERTIFICATE_DATE}."
            }
            layout {
                sequence: 30
            }
        )

        column CERTIFICATE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: "&{CERTIFICATE_NAME}."
            }
            layout {
                sequence: 20
            }
        )

        column SEQ_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: "&{SEQ_ID}."
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

    )

    region resume (
        name: Resume
