                --     APEX_MAIL.PUSH_QUEUE;
                -- END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 30352874558074634
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process set-personal-id (
        name: set personal id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :APP_USER_PERS_ID is not null then
                        :P125_PERSONAL_ID := :APP_USER_PERS_ID;
                        select email into :P125_EMAIL from account where id = :APP_USER_ACC_ID;
                    else
                        raise_application_error(-20100, 'please complete your personal information');
                    end if;
                
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 351441985706669612
        }
    )

    process submit-process (
        name: Submit Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                
                declare
                
                    v_app_id number;
                
                begin
                
                    -- insert the job_application items 
                    v_app_id := Job_application_pkg.Save_Job_application(:P125_RESUME, :APP_USER_ACC_ID);
                
                
                    -- insert certificates
                    IF APEX_COLLECTION.COLLECTION_EXISTS('CERTIFICATES') THEN
                        FOR rec IN (
                            SELECT
                                c001,
                                d001
                            FROM apex_collections
                            WHERE collection_name = 'CERTIFICATES'
                        )
                        LOOP
                
                            Job_application_pkg.Save_other_certificates(v_app_id,
                                rec.c001,
                                rec.d001);
                
                        END LOOP;
                        apex_collection.delete_collection('CERTIFICATES');
                    END IF;
                    --insert into job_vacancy_application
                    Job_application_pkg.Save_Vacancy_application(v_app_id, :P125_VACANCY_ID);
                
                    
                EXCEPTION
                    WHEN OTHERS THEN
                
                        -- Log the actual Oracle error
                        APEX_DEBUG.ERROR(
                            'Page 125 Submit Error: ' || SQLERRM ||
                            ' | Error Code: ' || SQLCODE ||
                            ' | Backtrace: ' || DBMS_UTILITY.FORMAT_ERROR_BACKTRACE
                        );
                
                        -- Add custom error to APEX
                        APEX_ERROR.ADD_ERROR(
                            p_message =>
                                'Unable to submit your application. ' ||
                                'Your attachment may be corrupted or invalid. ' ||
                                'Please change your PDF attachment and try again.',
                
                            p_display_location =>
                                APEX_ERROR.C_INLINE_IN_NOTIFICATION
                        );
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 351442370051669612
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 104
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)
