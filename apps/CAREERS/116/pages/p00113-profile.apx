    region personal-info-data-2 (
        name: Personal Info Data 2
        title: "&{PERSONAL_INFO_DATA_2}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pi.national_id_file_id,
                       pi.id as pi_id,
                       j.id,
                       j.file_name,
                       dbms_lob.getlength(j.file_blob) as image,
                       pi.MOTHER_FULL_NAME,
                       pi.MARITAL_STATUS as MARITAL_STATUS_ID,
                       pi.MILITARY_STATUS as MILITARY_STATUS_ID,
                       pi.PASSORT_NUMBER,
                       pi.ID AS EDIT,
                       mrs.name as MARITAL_STATUS,
                       mls.name as MILITARY_STATUS
                  from PERSONAL_INFO pi 
                  join MARITAL_STATUS mrs on mrs.id = pi.MARITAL_STATUS
                  join MILITARY_STATUS mls on mls.id = pi.MILITARY_STATUS
                  left join job_application_attachments j
                           on j.account_id = pi.account_id and j.FILE_TYPE_ID = 21
                where pi.account_id = :APP_USER_ACC_ID;
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @personal-info-data
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
