    region personal-info-data (
        name: Personal Info Data
        title: Personal Data Information
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select acc.ID AS ACC_ID,
                       acc.FIRST_NAME,
                       acc.LAST_NAME,
                       acc.DATE_OF_BIRTH,
                       acc.GENDER,
                       acc.EMAIL,
                       acc.MOBILE_TELEPHONE,
                       acc.HOME_TELEPHONE,
                       acc.ADDRESS,
                       c.name,
                       acc.JOIN_DATE,
                       acc.NATIONAL_ID,
                       acc.SECOND_NAME,
                       acc.PASSPORT_NUMBER,
                       acc.COUNTRY_ID,
                       cou.name as Country_Name,
                       acc.COUNTRY_PHONE_CODE_ID,
                       acc.ID AS EDIT
                  from ACCOUNT acc
                  join country cou on cou.id = acc.country_id   
                  JOIN CITIES c on c.id = acc.city_id 
                  where acc.id =  :APP_USER_ACC_ID;
                
                
                ```
        }
        layout {
            sequence: 50
            slot: body
            column: 3
            columnSpan: 8
