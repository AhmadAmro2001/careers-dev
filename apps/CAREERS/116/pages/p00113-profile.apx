            /* ========================================================== */
            /* RESPONSIVE IMPROVEMENTS                                    */
            /* ========================================================== */
            
            /* Tablets */
            @media (max-width: 992px) {
            
                .profile-big-icon {
                    font-size: 60px;
                }
            
                .profile-user-name {
                    font-size: 20px;
                    text-align: center;
                    word-break: break-word;
                }
            
                #modern_report,
                #language_1,
                #experience_2,
                #application_2 {
                    padding: 14px;
                }
            
                #modern_report .t-Report-cell,
                #language_1 .t-Report-cell,
                #experience_2 .t-Report-cell,
                #application_2 .t-Report-cell {
                    padding: 12px;
                }
            }
            
            
            /* Mobile */
            @media (max-width: 768px) {
            
                /* Profile Header */
                .profile-title {
                    padding: 15px 10px;
                    text-align: center;
                }
            
                .profile-big-icon {
                    font-size: 55px;
                }
            
                .profile-user-name {
                    font-size: 18px;
                    word-break: break-word;
                }
            
                /* User Email */
                .user-name {
                    word-break: break-word;
                    overflow-wrap: break-word;
                }
            
                /* Region Padding */
                #modern_report,
                #language_1,
                #experience_2,
                #application_2 {
                    padding: 10px;
                }
            
                /* Horizontal Scroll For Reports */
                #modern_report .t-Report-tableWrap,
                #language_1 .t-Report-tableWrap,
                #experience_2 .t-Report-tableWrap,
                #application_2 .t-Report-tableWrap {
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                }
            
                #modern_report .t-Report-report,
                #language_1 .t-Report-report,
                #experience_2 .t-Report-report,
                #application_2 .t-Report-report {
                    min-width: 700px;
                }
            
                /* Table Text */
                #modern_report .t-Report-cell,
                #language_1 .t-Report-cell,
                #experience_2 .t-Report-cell,
                #application_2 .t-Report-cell {
                    font-size: 13px;
                    padding: 10px;
                }
            
                /* Images */
                img {
                    max-width: 100% !important;
                    height: auto !important;
                }
            
                [data-header="National Id Image"] img,
                [data-header="NATIONAL_ID_IMAGE"] img {
                    width: 180px !important;
                    height: auto !important;
                }
            }
            
            
            /* Small Phones */
            @media (max-width: 480px) {
            
                .profile-big-icon {
                    font-size: 45px;
                }
            
                .profile-user-name {
                    font-size: 16px;
                }
            
                .custom-navbar {
                    padding: 10px;
                }
            
                .nav-link,
                .logout-btn {
                    font-size: 13px;
                    padding: 10px;
                }
            
                .user-name {
                    font-size: 13px;
                }
            
                #modern_report,
                #language_1,
                #experience_2,
                #application_2 {
                    padding: 8px;
                }
            }
            
            /* Prevent horizontal overflow */
            html,
            body,
            .t-Body-content,
            .t-Body-main,
            .t-Body-contentInner {
                max-width: 100%;
                overflow-x: hidden;
            }
            
            /* All regions */
            .t-Region {
                max-width: 100%;
            }
            
            /* All images */
            img {
                max-width: 100% !important;
                height: auto !important;
            }
            
            /* Long text */
            .user-name,
            .profile-user-name,
            td,
            th {
                overflow-wrap: break-word;
                word-break: break-word;
            }
            
            
            .guide-container {
                width: 100%;
                max-width: 1030px;
                margin: 20px auto;
                box-sizing: border-box;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region acc-reg (
        name: Acc_reg
        title: "&{ACCREG}."
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="profile-title">
                    <div class="profile-user-name">
                        &P113_USER_NAME.
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
            column: 3
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    region application2 (
        name: Application2
        title: "&{APPLICATION}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select jvp.ID,
                       jvp.VACANCY_ID,
                       jvp.DATE_TIME,
                       jv.title,
                       jvp.ID AS EDIT
                  from JOB_VACANCY_APPLICATION jvp
                  join job_application japp on japp.id = jvp.application_id
                  join job_vacancy jv on jv.id = jvp.vacancy_id
                  where japp.account_id = :APP_USER_ACC_ID;
                ```
        }
        layout {
            sequence: 110
            slot: body
            column: 3
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: application_2
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: you have not entered any data
        }

        column DATE_TIME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: "&{DATE_TIME}."
            }
            layout {
                sequence: 50
            }
        )

        column EDIT (
            reportColumnQueryId: 5
            derivedColumn: N
            type: link
            heading {
                heading: "&{EDIT}."
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 126
                    items: {
                        P126_ID: #ID#
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TITLE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: "&{TITLE}."
            }
            layout {
                sequence: 30
            }
        )

        column VACANCY_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

    )

    region education (
        name: Education
        title: "&{EDUCATION}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select eduD.GRADUATION_CERTIFICATE_FILE_ID,
                       eduD.id as eduD_id,
                       j.id,
                       j.file_name,
                       dbms_lob.getlength(j.file_blob) as image,
                       eduD.EDUCATION_LEVEL as EDUCATION_LEVEL_ID,
                       eduD.EDUCATION_FIELD as EDUCATION_FIELD_ID,
                       eduD.GRADUATION_YEAR,
                       eduD.EDUCATION_GRADE as EDUCATION_GRADE_ID,
                       eduD.UNIVERSITY,
                       eduD.OTHER_EDUCATION_FIELD,
                       eduD.PERSONAL_ID,
                       eduD.ID AS EDIT,
                       eduL.name as EDUCATION_LEVEL,
                       eduF.name as EDUCATION_FIELD,
                       eduG.name as EDUCATION_GRADE
                  from EDUCATION_DEGREE eduD
                  join personal_info pi on pi.id = eduD.personal_id
                  join education_level eduL on eduL.id = eduD.EDUCATION_LEVEL
                  join EDUCATION_FIELD eduF on eduF.id = eduD.EDUCATION_FIELD
                  join EDUCATION_GRADE eduG on eduG.id = eduD.EDUCATION_GRADE
                  
                  left join job_application_attachments j
                           on j.id = eduD.GRADUATION_CERTIFICATE_FILE_ID
                  where personal_id = :APP_USER_PERS_ID;
                ```
        }
        layout {
            sequence: 60
            slot: body
            column: 3
            columnSpan: 8
        }
