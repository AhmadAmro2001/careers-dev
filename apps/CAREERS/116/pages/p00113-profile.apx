page 113 (
    name: Profile
    alias: PROFILE
    title: "&{PROFILE}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .profile-title{
                display:flex;
                flex-direction:column;
                align-items:center;
                justify-content:center;
                padding:10px 0;
            }
            
            .profile-big-icon{
                font-size:70px;
                color:#6C63FF;
                margin-bottom:10px;
            }
            
            .profile-user-name{
                font-size:22px;
                font-weight:600;
                color:#333;
            }
            
            
            /* Region Container */
            #modern_report {
                background: #f8fafc;
                border-radius: 18px;
                padding: 18px;
                box-shadow: 0 4px 14px rgba(0,0,0,0.08);
                border: none;
            }
            
            /* Report Table */
            #modern_report .t-Report-report {
                border-collapse: separate;
                border-spacing: 0 10px;
                width: 100%;
            }
            
            /* Header */
            #modern_report .t-Report-colHead {
                background: #001b47;
                color: white;
                font-size: 14px;
                font-weight: 600;
                padding: 14px;
                border: none;
            }
            
            /* Header First/Last Radius */
            #modern_report .t-Report-colHead:first-child {
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }
            
            #modern_report .t-Report-colHead:last-child {
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }
            
            /* Rows */
            #modern_report .t-Report-report tbody tr {
                background: white;
                transition: 0.3s;
                box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            }
            
            /* Rows Links */
            #modern_report .t-Report-report tbody tr a{
                color: rgb(0, 48, 65);
                text-decoration: none;
                font-weight: 600;
            }
            
            #modern_report .t-Report-report tbody tr a:hover{
                color: rgb(0, 119, 255);
            }
            
            /* Hover Effect */
            #modern_report .t-Report-report tbody tr:hover {
                transform: scale(1.01);
                background: #f1f5f9;
            }
            
            /* Cells */
            #modern_report .t-Report-cell {
                padding: 16px;
                border: none;
                font-size: 14px;
                color: #334155;
            }
            
            /* First Cell Radius */
            #modern_report .t-Report-cell:first-child {
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }
            
            /* Last Cell Radius */
            #modern_report .t-Report-cell:last-child {
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }
            
            /* Pagination */
            #modern_report .t-Report-pagination {
                margin-top: 15px;
                text-align: center;
            }
            
            /* Links */
            #modern_report a {
                color: rgb(169, 234, 255);
                text-decoration: none;
                font-weight: 600;
            }
            
            #modern_report a:hover {
                color: #9db7ff;
            }
            
            #modern_report,
            #modern_report .t-Region-body,
            #modern_report .t-Report,
            #modern_report .t-Report-wrap,
            #modern_report .t-Report-tableWrap {
                border: none !important;
                box-shadow: none !important;
                background: transparent !important;
            }
            
            /* Remove table borders */
            #modern_report table,
            #modern_report th,
            #modern_report td {
                border: none !important;
            }
            
            /* Remove outer gray line */
            #modern_report .t-Report-report {
                border: none !important;
                outline: none !important;
            }
            
            
            
            /* ========================================================== */
            /* CUSTOM NAVBAR                                               */
            /* ========================================================== */
            
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            
                background: rgb(233, 233, 233);
            
                padding: 14px 24px;
            
                border-radius: 18px;
            
                box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            
                margin-bottom: 20px;
            }
            
            /* Left Links */
            .nav-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            
            /* Nav Links */
            .nav-link {
                display: flex;
                align-items: center;
                gap: 8px;
            
                text-decoration: none;
            
                color: #334155;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Hover */
            .nav-link:hover {
                background: rgb(232, 244, 255);
                color: #0563bb;
            }
            
            /* Logout Button */
            .logout-btn {
                display: flex;
                align-items: center;
                gap: 8px;
            
                background: #ef4444;
            
                color: white !important;
            
                text-decoration: none;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Logout Hover */
            .logout-btn:hover {
                background: #dc2626;
                transform: translateY(-1px);
            }
            
            /* Icons */
            .custom-navbar .fa {
                font-size: 14px;
            }
            
            
            [data-header="National Id Image"] img,
            [data-header="NATIONAL_ID_IMAGE"] img {
                width: 300px !important;
                height: 100px !important;
            }
            
            
            img {
                width: 250px !important;
                height: 100px !important;
                object-fit: cover;
                border-radius: 10px;
            }
            
            .nav-right {
                display: flex;
                align-items: center;
                gap: 15px;
            }
            
            .user-name {
                color: #333;
                font-weight: 600;
            }
            
            
            /* Make navbar wrap on small screens */
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap; /* مهم جداً */
            }
            
            /* Mobile & small tablets */
            @media (max-width: 768px) {
                .custom-navbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 12px;
                }
            
                .nav-left,
                .nav-right {
                    width: 100%;
                    justify-content: flex-start;
                    flex-wrap: wrap;
                }
            
                .nav-link,
                .logout-btn {
                    width: 100%;
                    justify-content: center;
                }
            
                .user-name {
                    width: 100%;
                    text-align: left;
                }
            }
            
            /* Very small screens (phones) */
            @media (max-width: 480px) {
                .nav-link,
                .logout-btn {
                    padding: 12px;
                    font-size: 14px;
                }
            
                .custom-navbar {
                    padding: 12px;
                }
            }
            
            
            /* Region Container */
