    process get-profile-data (
        name: Get Profile Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                
                
                    select FIRST_NAME || ' ' || SECOND_NAME || ' ' || LAST_NAME as Full_Name into :P113_USER_NAME
                    from account where id = :APP_USER_ACC_ID;
                
                
                    select id into :APP_USER_PERS_ID from personal_info where account_id = :APP_USER_ACC_ID;
                
                
                    exception
                        when no_data_found then
                            :APP_USER_PERS_ID := null;
                
                end ;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 345353927037189221
        }
    )

    process logout-process (
        name: logout Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    APEX_UTIL.SET_SESSION_STATE('APP_USER_ACC_ID', NULL);
                    APEX_UTIL.SET_SESSION_STATE('APP_USER_PERS_ID', NULL);
                    -- apex_authentication.logout;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 353496524203439871
        }
        serverSideCondition {
            type: request=Value
            value: LOGOUT
        }
        config {
            buildOption: @commented-out
        }
    )

    branch (
        name: logout process
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 9999
            }
        }
        serverSideCondition {
            type: request=Value
            value: LOGOUT
        }
        config {
            buildOption: @commented-out
        }
    )

)
