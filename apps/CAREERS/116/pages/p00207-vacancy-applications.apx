    process archive-app (
        name: TOGGLE_APPLICATION_ARCHIVE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                
                declare
                    l_application_id number;
                    l_action         varchar2(20);
                begin
                    l_application_id := to_number(apex_application.g_x01);
                    l_action         := upper(apex_application.g_x02);
                
                    if l_action = 'ARCHIVE' then
                
                        -- Replace this with your real archive procedure
                        PKG_ADMIN.archive_application(
                            p_application_id => TO_NUMBER(apex_application.g_x01)
                        );
                
                        apex_json.open_object;
                        apex_json.write('success', true);
                        apex_json.write('message', 'Application archived successfully.');
                        apex_json.close_object;
                
                    elsif l_action = 'UNARCHIVE' then
                
                        -- Replace this with your real unarchive procedure
                        PKG_ADMIN.unarchive_application(
                            p_application_id => TO_NUMBER(apex_application.g_x01)
                        );
                
                        apex_json.open_object;
                        apex_json.write('success', true);
                        apex_json.write('message', 'Application unarchived successfully.');
                        apex_json.close_object;
                
                    else
                        raise_application_error(-20001, 'Invalid archive action.');
                    end if;
                
                exception
                    when others then
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', sqlerrm);
                        apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 346286738550867865
        }
    )

    process download-application-documents (
        name: DOWNLOAD APPLICATION DOCUMENTS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_zip BLOB;
                
                    l_resume_blob       BLOB;
                    l_resume_name       VARCHAR2(500);
                
                    l_national_blob     BLOB;
                    l_national_name     VARCHAR2(500);
                
                    l_graduation_blob   BLOB;
                    l_graduation_name   VARCHAR2(500);
                
                    l_extension         VARCHAR2(100);
                
                BEGIN
                
                    /* =========================================================
                       1. GET RESUME
                       Resume is linked through JOB_APPLICATION.RESUME_FILE_ID
                       ========================================================= */
                
                    BEGIN
                        SELECT
                            att.FILE_BLOB,
                            att.FILE_NAME
                        INTO
                            l_resume_blob,
                            l_resume_name
                        FROM JOB_APPLICATION j
                        JOIN JOB_APPLICATION_ATTACHMENTS att
                            ON att.ID = j.RESUME_FILE_ID
                        WHERE j.ID = :P207_JOB_ID
                          AND j.ACCOUNT_ID = :P207_ACCOUNT_ID
                          AND att.FILE_BLOB IS NOT NULL;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_resume_blob := NULL;
                            l_resume_name := NULL;
                    END;
                
                
                    /* =========================================================
                       2. GET NATIONAL ID
                       Personal_Info.NATIONAL_ID_FILE_ID
                       ========================================================= */
                
                    BEGIN
                        SELECT
                            att.FILE_BLOB,
                            att.FILE_NAME
                        INTO
                            l_national_blob,
                            l_national_name
                        FROM PERSONAL_INFO pi
                        JOIN JOB_APPLICATION_ATTACHMENTS att
                            ON att.ID = pi.NATIONAL_ID_FILE_ID
                        WHERE pi.ACCOUNT_ID = :P207_ACCOUNT_ID
                          AND att.FILE_BLOB IS NOT NULL
                        FETCH FIRST 1 ROW ONLY;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_national_blob := NULL;
                            l_national_name := NULL;
                    END;
                
                
                    /* =========================================================
                       3. GET GRADUATION CERTIFICATE
                       FILE_TYPE_ID = 1
                       ========================================================= */
                
                    BEGIN
                        SELECT
                            att.FILE_BLOB,
                            att.FILE_NAME
                        INTO
                            l_graduation_blob,
                            l_graduation_name
                        FROM JOB_APPLICATION_ATTACHMENTS att
                        WHERE att.ACCOUNT_ID = :P207_ACCOUNT_ID
                          AND att.FILE_TYPE_ID = 1
                          AND att.FILE_BLOB IS NOT NULL
                        ORDER BY att.ID DESC
                        FETCH FIRST 1 ROW ONLY;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_graduation_blob := NULL;
                            l_graduation_name := NULL;
                    END;
                
                
                    /* =========================================================
                       4. ADD RESUME IF EXISTS
                       ========================================================= */
                
                    IF l_resume_blob IS NOT NULL THEN
                
                        l_extension :=
                            CASE
                                WHEN INSTR(l_resume_name, '.', -1) > 0
                                THEN SUBSTR(l_resume_name, INSTR(l_resume_name, '.', -1))
                                ELSE ''
                            END;
                
                        apex_zip.add_file(
                            p_zipped_blob => l_zip,
                            p_file_name   => :P207_ACCOUNT_ID ||
                                             '_resume' ||
                                             l_extension,
                            p_content     => l_resume_blob
                        );
                
                    END IF;
                
                
                    /* =========================================================
                       5. ADD NATIONAL ID IF EXISTS
                       ========================================================= */
                
                    IF l_national_blob IS NOT NULL THEN
                
                        l_extension :=
                            CASE
                                WHEN INSTR(l_national_name, '.', -1) > 0
                                THEN SUBSTR(l_national_name, INSTR(l_national_name, '.', -1))
                                ELSE ''
                            END;
                
                        apex_zip.add_file(
                            p_zipped_blob => l_zip,
                            p_file_name   => :P207_ACCOUNT_ID ||
                                             '_national_id' ||
                                             l_extension,
                            p_content     => l_national_blob
                        );
                
                    END IF;
                
                
                    /* =========================================================
                       6. ADD GRADUATION CERTIFICATE IF EXISTS
                       ========================================================= */
                
                    IF l_graduation_blob IS NOT NULL THEN
                
                        l_extension :=
                            CASE
                                WHEN INSTR(l_graduation_name, '.', -1) > 0
                                THEN SUBSTR(
                                    l_graduation_name,
                                    INSTR(l_graduation_name, '.', -1)
                                )
                                ELSE ''
                            END;
                
                        apex_zip.add_file(
                            p_zipped_blob => l_zip,
                            p_file_name   => :P207_ACCOUNT_ID ||
                                             '_graduation_certificate' ||
                                             l_extension,
                            p_content     => l_graduation_blob
                        );
                
                    END IF;
                
                
                    /* =========================================================
                       7. FINISH ZIP
                       ========================================================= */
                
                    apex_zip.finish(
                        p_zipped_blob => l_zip
                    );
                
                
                    /* =========================================================
                       8. DOWNLOAD ZIP
                       ========================================================= */
                
                    owa_util.mime_header(
                        'application/zip',
                        FALSE
                    );
                
                    htp.p(
                        'Content-Length: ' ||
                        dbms_lob.getlength(l_zip)
                    );
                
                    htp.p(
                        'Content-Disposition: attachment; filename="' ||
                        :P207_ACCOUNT_ID ||
                        '_Documents.zip"'
                    );
                
                    owa_util.http_header_close;
                
                    wpg_docload.download_file(l_zip);
                
                    apex_application.stop_apex_engine;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 38626402247455049
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'DOWNLOAD_ZIP'
        }
    )

