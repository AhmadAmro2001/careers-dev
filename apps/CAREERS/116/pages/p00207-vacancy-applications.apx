    dynamicAction new (
        name: New
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .archive-btn
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    
                    
                    var btn = this.triggeringElement;
                    var applicationId = btn.dataset.id;
                    var action = btn.dataset.archiveAction;
                    
                    apex.server.process(
                        "TOGGLE_APPLICATION_ARCHIVE",
                        {
                            x01: applicationId,
                            x02: action
                        },
                        {
                            dataType: "json",
                            success: function (data) {
                                if (data.success) {
                                    apex.message.showPageSuccess(data.message);
                                    apex.region("cr_docs").refresh();
                                } else {
                                    apex.message.showErrors([
                                        {
                                            type: "error",
                                            location: "page",
                                            message: data.message,
                                            unsafe: false
                                        }
                                    ]);
                                }
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                                apex.message.showErrors([
                                    {
                                        type: "error",
                                        location: "page",
                                        message: "Error while changing archive status: " + errorThrown,
                                        unsafe: false
                                    }
                                ]);
                            }
                        }
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

