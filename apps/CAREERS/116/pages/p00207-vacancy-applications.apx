page 207 (
    name: Vacancy Applications
    alias: VACANCY-APPLICATIONS
    title: "&{VACANCY_APPLICATIONS}."
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fixResumeDownloadButtons() {
                var region$ = apex.jQuery("#cr_docs");
            
                region$.find('td[headers="RESUME_DOWNLOAD"]').each(function () {
                    var cell$ = apex.jQuery(this);
                    var link$ = cell$.find("a");
            
                    // If APEX did not generate a download link, show disabled N/A button
                    if (link$.length === 0) {
                        cell$.html(
                            '<button type="button" class="resume-btn resume-btn-disabled disabled-button" disabled>N/A</button>'
                        );
                    } else {
                        // Style the real APEX download link like a button
                        link$.addClass("resume-btn");
                        // link$.text("<span class='fa fa-download'></span> ");
                    }
                });
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.addEventListener("change", function (event) {
                if (event.target.id === "check_all_docs") {
                    // apex.item("P207_SELECT_ALL").setValue(event.target.checked ? "Y" : "N");
            
                    document
                        .querySelectorAll("#cr_docs input.js-row-check")
                        .forEach(function (checkbox) {
                            checkbox.checked = event.target.checked;
                        });
                }
            });
            
            // resume download button 
            fixResumeDownloadButtons();
            
            apex.jQuery("#cr_docs").on("apexafterrefresh", function () {
                fixResumeDownloadButtons();
            });
            ```
    }
    css {
        inline:
            ```css
            .more-details-btn {
              background-color: var(--careers-primary-color);
              color: white !important;
              padding: 10px 18px;
              border-radius: 8px;
              text-decoration: none !important;
              display: inline-block;
              font-size: 14px;
              transition: background-color 0.3s ease;
            }
            
            .more-details-btn:hover {
              background-color: var(--careers-hover-color);
              color: white !important;
            }
            
            .disabled-button {
              background-color: var(--careers-primary-color);
              color: white !important;
              padding: 8px 10px;
              border-radius: 8px;
              text-decoration: none !important;
              display: inline-block;
              font-size: 14px;
              transition: background-color 0.3s ease;
            }
            
            .disabled-button:hover {
              background-color: var(--careers-hover-color);
              color: white !important;
            }
            
            /* download resume css button */
            
            
            #cr_docs td[headers="RESUME_DOWNLOAD"] a {
              background-color: var(--careers-primary-color);
              color: white !important;
              padding: 10px 18px;
              border-radius: 8px;
              text-decoration: none !important;
              display: inline-block;
              font-size: 13px;
              transition: background-color 0.3s ease;
              /* font-weight: bold; */
            }
            
            #cr_docs td[headers="RESUME_DOWNLOAD"] a:hover {
              background-color: var(--careers-hover-color);
              color: white !important;
            }
            
            /* ARCHIVE BUTTON */
            .archive-btn {
              background-color: var(--careers-primary-color);
              color: white !important;
              padding: 8px 14px;
              border-radius: 8px;
              text-decoration: none !important;
              display: inline-block;
              font-size: 13px;
              /* font-weight: bold; */
              cursor: pointer;
            }
            
            .archive-btn:hover {
              background-color: var(--careers-hover-color);
            }
            
            .archive-btn-zip {
              background-color: var(--careers-primary-color);
              color: white !important;
              padding: 8px 14px;
              border-radius: 8px;
              text-decoration: none !important;
              display: inline-block;
              font-size: 13px;
              /* font-weight: bold; */
              cursor: pointer;
            }
            
            .archive-btn-zip:hover {
              background-color: var(--careers-hover-color);
            }
            
            .archive-disabled {
                opacity: 0.5;
                /* pointer-events: none; */
                /* cursor: not-allowed; */
            }
            .applications-count {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                
                
            }
            
            .applications-count strong {
                color: #18a52b;
                font-size: 16px;
            }
            ```
    }
    security {
        authorizationScheme: @admin-schema
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region applications (
        name: Applications
        title: "&{APPLICATIONS}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox2(
                        p_idx        => 1,
                        p_value      => j.ID,
                        p_attributes => 'class="js-row-check"'
                    ) as select_row,
                       j.ID as JOB_ID,
                       u.ID as ACCOUNT_ID ,
                       u.FIRST_NAME,
                       u.SECOND_NAME,
                       u.LAST_NAME,
                       j.LAST_UPDATE_DATE,
                
                       e.EDUCATION_LEVEL as EDUCATION_DEGREE,
                       e.EDUCATION_GRADE as EDUCATION_GRADE,
                       e.EDUCATION_FIELD as EDUCATION_FIELD,
                       e.GRADUATION_YEAR as GRADE_YEAR,
                       u.GENDER AS ACCOUNT_GENDER,
                       j.IS_ARCHIVED as APPLICATION_ARCHIVED,
                       u.IS_ARCHIVE as ACCOUNT_ARCHIVED,
                       u.MOBILE_TELEPHONE,
                       u.NATIONAL_ID,
                       u.city_id,
                       j.creation_date,
                       va.title,
                       case
                           when exp.total_exp_years < 1 then '0-1'
                           when exp.total_exp_years >= 1  and exp.total_exp_years < 6  then '1-5'
                           when exp.total_exp_years >= 6  and exp.total_exp_years < 11 then '6-10'
                           when exp.total_exp_years >= 10 and exp.total_exp_years < 20 then '11-15'
                           when exp.total_exp_years >= 15 and exp.total_exp_years < 20 then '15-20'
                           when exp.total_exp_years >= 20 then '20+'
                           else '0-1'
                       end as EXP_YEARS,
                
                       'More Details' as MORE_DETAILS,
                        dbms_lob.getlength(jat.FILE_BLOB) as RESUME_DOWNLOAD,
                        jat.file_name as resume_file_name,
                        jat.mime_type as resume_mime_type,
                        jat.id as ID,
                        case 
                            when nvl(j.IS_ARCHIVED, 0) = 1 then 'UNARCHIVE'
                            else 'ARCHIVE'
                        end as ARCHIVE_ACTION,
                
                        case 
                            when nvl(j.IS_ARCHIVED, 0) = 1 then 'Unarchive Application'
                            else 'Archive Application'
                        end as ARCHIVE_TITLE,
                
                        case 
                            when nvl(j.IS_ARCHIVED, 0) = 1 then 'fa-undo'
                            else 'fa-archive'
                        end as ARCHIVE_ICON,
                
                        case 
                            when nvl(j.IS_ARCHIVED, 0) = 1 then 'Unarchive'
                            else 'Archive'
                        end as ARCHIVE_APP,
                
                        case 
                            when nvl(j.IS_ARCHIVED, 0) = 1 then 'is-archived'
                            else 'is-active'
                        end as ARCHIVE_STATE_CLASS,
                
                        j.ID as ARCHIVE_DATA,
                        
                        '<a href="' ||
                        apex_escape.html_attribute(
                            apex_page.get_url(
                                p_page    => :APP_PAGE_ID,
                                p_request => 'DOWNLOAD_ZIP',
                                p_items   => 'P207_JOB_ID,P207_ACCOUNT_ID',
                                p_values  => j.ID || ',' || u.ID
                                )
                            ) ||
                        '" class="t-Button archive-btn-zip ">
                            <span class="fa fa-download"></span> '|| ' ' ||'
                            
                        </a>' as DOWNLOAD_ZIP
                
                from Job_Application j
                
                 join ACCOUNT u
                    on j.Account_ID = u.ID
                
                -- left join education_degree e
                --     on j.ID = e.JOB_APPLICATION_ID
                left join personal_info pi
                   on pi.Account_ID = j.Account_ID
                left join (
                    select *
                    from (
                        select 
                               e.*,
                               row_number() over (
                                   partition by e.personal_id
                                   order by e.id desc
                               ) as rn
                        from education_degree e
                    )
                    where rn = 1
                ) e
                    on pi.id = e.personal_id
                
                LEFT join education_level el
                    on e.education_level = el.ID
                
                left join (
                    select 
                           jae.PERSONAL_ID,
                           sum(months_between(nvl(jae.todate, sysdate), jae.fromdate)) / 12 as total_exp_years
                    from JOB_APPLICATION_EXPERIENCE jae
                    group by jae.PERSONAL_ID
                ) exp
                    on exp.PERSONAL_ID = pi.ID
                
                left join JOB_APPLICATION_ATTACHMENTS jat
                on jat.id = j.RESUME_FILE_ID and jat.FILE_TYPE_ID = 2
                
                right JOIN JOB_VACANCY_APPLICATION jva
                on jva.APPLICATION_ID = j.ID
                left join JOB_VACANCY va
                on va.id = jva.vacancy_id
                
                where jva.VACANCY_ID = :P207_SELECTED_ID 
                and (:P207_FIRST_NAME is null or upper(u.FIRST_NAME) = upper(:P207_FIRST_NAME))
                and (:P207_LAST_NAME is null or upper(:P207_LAST_NAME) = upper(u.LAST_NAME))
                and resume_file_id is not null
                order by j.CREATION_DATE desc;
                ```
            pageItemsToSubmit: [
                P207_FIRST_NAME
                P207_LAST_NAME
            ]
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
