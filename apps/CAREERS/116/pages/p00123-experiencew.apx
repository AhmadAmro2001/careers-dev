    process exp-check (
        name: Exp_Check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    SELECT 1
                    INTO :P123_EXP_CHECK
                    FROM JOB_APPLICATION_EXPERIENCE
                    WHERE personal_id = :APP_USER_PERS_ID
                    FETCH FIRST 1 ROW ONLY;
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        :P123_EXP_CHECK := 0;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 351146892297910054
        }
    )

