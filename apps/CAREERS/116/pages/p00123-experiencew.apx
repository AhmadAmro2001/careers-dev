    process process-form-experience-fresh-grad (
        name: Process form Experience Fresh Grad
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                v_exp_check number;
                v_country_id number;
                
                begin
                
                if :APP_USER_PERS_ID IS NOT NULL THEN
                    SELECT a.COUNTRY_ID
                    INTO v_country_id
                        FROM PERSONAL_INFO pi
                        JOIN ACCOUNT a
                            ON a.ID = pi.ACCOUNT_ID
                        WHERE pi.ID = :APP_USER_PERS_ID;
                
                    select count(*) into v_exp_check from JOB_APPLICATION_EXPERIENCE where personal_id = :APP_USER_PERS_ID;
                END IF;
                
                if v_exp_check > 0 then
                    raise_application_error(-20200, 'you already added experience!');
                end if;
                
                insert into JOB_APPLICATION_EXPERIENCE(POSITION_NAME, COMPANY, FROMDATE, OTHER_DETAILS, COUNTRY_ID, PERSONAL_ID, TODATE)Values('fresh grad', 'N/A', sysdate, null, v_country_id, :APP_USER_PERS_ID, sysdate);
                
                
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 57701978896386128
        }
        serverSideCondition {
            whenButtonPressed: @fresh-grad
        }
    )

