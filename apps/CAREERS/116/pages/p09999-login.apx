    process new (
        name: Redirect
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_user account%rowtype;
                    cred_result boolean;
                    invalid_cred exception;
                    l_reset number;
                BEGIN
                
                    
                
                    select count(*)
                    into l_reset
                    from admin 
                    where upper(email) = upper(:P9999_USERNAME);
                
                    cred_result := USER_ACCOUNT_PACKAGE.authenticate(
                        :P9999_USERNAME,
                        :P9999_PASSWORD
                        );
                
                
                    if cred_result = true and l_reset > 0 then 
                
                
                    IF :G_USER_ROLE = 1 THEN
                            apex_util.redirect_url(
                                apex_page.get_url(
                                    p_page   => 102,
                                    p_items  => 'P102_EMAIL',
                                    p_values => :P9999_USERNAME
                                )
                            );
                        END IF;  
                
                
                
                    elsif   l_reset = 0 then
                
                        SELECT *
                        INTO l_user
                        FROM account
                        WHERE upper(email) = upper(:P9999_USERNAME);  
                
                        IF :G_USER_ROLE = 0 and cred_result = true and (l_user.RESET_PASSWORD_FLG = 1  ) THEN
                
                                apex_util.redirect_url(
                                apex_page.get_url(
                                    p_page   => 102,
                                    p_items  => 'P102_PERS_ID_CHECK,P102_EMAIL' ,
                                    p_values => :P9999_PERS_ID_CHECK || ',' || :P9999_USERNAME 
                
                                )
                            );
                
                            -- end if;
                         elsif :G_USER_ROLE = 0 and  (l_user.RESET_PASSWORD_FLG = 0  ) then
                            apex_util.redirect_url(
                            apex_page.get_url(
                                p_page   => 106,
                                p_items  => 'P106_ACC_ID' ,
                                p_values => l_user.id
                
                                )
                            );
                            
                        -- ELSE
                        --     apex_util.redirect_url('f?p=&APP_ID.:9999:&SESSION.'); -- fallback page
                        END IF;
                        
                   
                        
                
                    else 
                        
                
                            raise invalid_cred;
                   
                    end if;
                    
                
                EXCEPTION
                    WHEN invalid_cred THEN
                        RAISE_APPLICATION_ERROR(-20022,'Invalid Cred.');
                
                    
                END;
                
                
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 17176128863907636
        }
    )

