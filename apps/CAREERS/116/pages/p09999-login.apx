    process verfication (
        name: Verfication
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_code VARCHAR2(6);
                    l_reset number;
                    l_test number;
                    cred_result boolean;
                    invalid_cred exception;
                
                BEGIN
                
                    cred_result := USER_ACCOUNT_PACKAGE.authenticate(
                        :P9999_USERNAME,
                        :P9999_PASSWORD
                        );
                
                    select count(*)
                    into l_test
                    from admin 
                    where upper(email) = upper(:P9999_USERNAME);
                
                
                
                -- and (l_reset = 1)
                if cred_result = true and l_test = 0  then
                
                    select RESET_PASSWORD_FLG
                    into l_reset
                    from account 
                    where upper(email) = upper(:P9999_USERNAME);
                    if l_reset = 1 then
                    -- generate 6-digit OTP
                        l_code := LPAD(TRUNC(DBMS_RANDOM.VALUE(0, 999999)), 6, '0');
                
                
                        IF :P9999_USERNAME IS NULL THEN
                            raise_application_error(-20002, APEX_LANG.GET_MESSAGE('EMAIL_IS_REQUIRED'));
                        END IF;
                
                
                    -- store code
                        INSERT INTO user_verification (email, code, expires_at)
                        VALUES (
                            :P9999_USERNAME,
                            l_code,
                            SYSTIMESTAMP + INTERVAL '10' MINUTE
                        );
                
                    -- send email
                        APEX_MAIL.SEND(
                            p_to   => :P9999_USERNAME,
                            p_from => 'apex@eprom.com.eg',
                            p_subj => 'Login Verification Code',
                            p_body => 'Your verification code is: ' || l_code ||
                                      CHR(10) || 'It expires in 10 minutes.'
                        );
                
                        APEX_MAIL.PUSH_QUEUE;
                    end if;
                    -- and (l_reset = 1 )
                elsif cred_result = true and l_test = 1  then
                     l_code := LPAD(TRUNC(DBMS_RANDOM.VALUE(0, 999999)), 6, '0');
                
                
                        IF :P9999_USERNAME IS NULL THEN
                            raise_application_error(-20002, APEX_LANG.GET_MESSAGE('EMAIL_IS_REQUIRED'));
                        END IF;
                
                
                    -- store code
                        INSERT INTO user_verification (email, code, expires_at)
                        VALUES (
                            :P9999_USERNAME,
                            l_code,
                            SYSTIMESTAMP + INTERVAL '10' MINUTE
                        );
                
                    -- send email
                        APEX_MAIL.SEND(
                            p_to   => :P9999_USERNAME,
                            p_from => 'apex@eprom.com.eg',
                            p_subj => 'Login Verification Code',
                            p_body => 'Your verification code is: ' || l_code ||
                                      CHR(10) || 'It expires in 10 minutes.'
                        );
                
                        APEX_MAIL.PUSH_QUEUE;
                -- else  
                --     raise invalid_cred;
                end if;
                -- EXCEPTION
                --     WHEN invalid_cred THEN
                --         RAISE_APPLICATION_ERROR(-20024,'Invalid Cred.');
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 44876179820641619
        }
    )

    branch (
        name: logout process
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 9999
            }
        }
        serverSideCondition {
            type: request=Value
            value: LOGOUT
        }
    )

    branch (
        name: otp
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 2
                items: {
                    P2_EMAIL: &P9999_USERNAME.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @forget-password_1
        }
    )

    pageItem P9999_LANGUAGE (
        type: hidden
        layout {
            sequence: 80
            region: @careers
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    button switch-to-arabic (
        buttonName: SWITCH_TO_ARABIC
        label: العربيه
        layout {
            sequence: 22
            region: @careers
            slot: create
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            cssClasses: language-switch language-switch--arabic
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
                clearCache: 9999
                items: {
                    P9999_LANGUAGE: ar
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )
    button switch-to-english (
        buttonName: SWITCH_TO_ENGLISH
        label: English
        layout {
            sequence: 21
            region: @careers
            slot: create
            startNewRow: true
        }
        appearance {
            buttonTemplate: @/text
            cssClasses: language-switch language-switch--english
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
                clearCache: 9999
                items: {
                    P9999_LANGUAGE: en
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )
    process apply-login-language (
        name: Apply login language
        type: executeCode
        execution {
            sequence: 5
            point: beforeHeader
        }
        source {
            plsqlCode:
                ```plsql
                IF LOWER(:P9999_LANGUAGE) IN ('en', 'ar') THEN
                    APEX_UTIL.SET_SESSION_STATE(
                        p_name   => 'G_UI_LANGUAGE',
                        p_value  => LOWER(:P9999_LANGUAGE),
                        p_commit => FALSE
                    );
                    APEX_UTIL.SET_SESSION_LANG(LOWER(:P9999_LANGUAGE));
                    APEX_UTIL.REDIRECT_URL(
                        APEX_PAGE.GET_URL(
                            p_page        => 9999,
                            p_clear_cache => '9999'
                        )
                    );
                    APEX_APPLICATION.STOP_APEX_ENGINE;
                END IF;
                ```
        }
    )

)
