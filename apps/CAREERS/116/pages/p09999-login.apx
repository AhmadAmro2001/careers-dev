page 9999 (
    name: Login Page
    alias: LOGIN
    title: "&{CAREERS_LOG_IN}."
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: https://www.google.com/recaptcha/api.js
    }
    css {
        fileUrls: #APP_FILES#careers#MIN#.css
        inline:
            ```css
            .no-border-item input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                pointer-events: none;
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
            }
            
            
            
            body {
                background-image: url("#APP_FILES#CareerBackGround4.jpg");
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            
            
            /* Secondary Action (Back) */
            #Login {
                /* background: transparent !important; */
                background: rgba(9, 8, 66, 1) !important;
                color: rgba(255, 255, 255, 0.7) !important;
                border: 1px solid rgba(255, 255, 255, 0.3) !important;
            }
            
            #Login:hover {
                color: #000000ff !important;
                border-color: #ffffff !important;
                background: rgba(9, 8, 66, 0.36) !important;
            }
            
            
            #caution .t-Region-body {
                padding-top: 0 !important;
            }
            
            #caution .t-Region-content {
                padding-top: 0 !important;
            
            
            }
            
            #eprom-warning .t-Region-body {
                padding-top: 0 !important;
            }
            
            #eprom-warning .t-Region-content {
                padding-top: 0 !important;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

