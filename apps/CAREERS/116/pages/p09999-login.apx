    process reset-password (
        name: Reset Password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    reset_flag varchar2(50);
                    v_acc_id number;
                
                BEGIN
                
                    reset_flag := PKG_ADMIN.reset_pass_check(:P9999_USERNAME);
                
                    if reset_flag = 'RESET_ADMIN' then
                        APEX_UTIL.SET_SESSION_STATE('G_UI_LANGUAGE', 'en', p_commit => FALSE);
                        APEX_UTIL.SET_SESSION_LANG('en');
                        APEX_UTIL.REDIRECT_URL(
                                APEX_PAGE.GET_URL(
                                    p_page   => 201,
                                    p_items  => 'P201_USERNAME',
                                    p_values => :P9999_USERNAME
                                )
                            );
                        apex_application.stop_apex_engine;
                    elsif reset_flag = 'RESET_USER' then
                        select id into v_acc_id from account where lower(email) = lower(:P9999_USERNAME);
                         APEX_UTIL.REDIRECT_URL(
                            APEX_PAGE.GET_URL(
                                p_page => 106,
                                p_items  => 'P106_ACC_ID',
                                p_values => v_acc_id
                            )
                        );
                        apex_application.stop_apex_engine;
                    else 
                        NULL;
                    end if;
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 16988071802402318
        }
        serverSideCondition {
            whenButtonPressed: @login
        }
    )

    process set-ids (
        name: Set ids
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                v_admin_id varchar2(100);
                v_acc_id number;
                
                
                begin
                --  :G_USER_ROLE := null;
                -- raise_application_error(-20111,:APP_USER_ACC_ID);
                    APEX_UTIL.SET_SESSION_STATE('APP_USER_ACC_ID', NULL);
                    APEX_UTIL.SET_SESSION_STATE('APP_USER_PERS_ID', NULL);
                
                    -- :P103_ACC_ID := user_account_package.login(:P103_MOBILE_TELEPHONE, :P103_PASSWORD);
                    if :G_USER_ROLE = 1 then
                        select id into v_admin_id from admin where upper(email) = upper(:P9999_USERNAME);
                        APEX_UTIL.SET_SESSION_STATE('G_USER_ROLE', 1);
                        -- :P9999_IS_ADMIN := 1;
                    else
                        APEX_UTIL.SET_SESSION_STATE('G_USER_ROLE', 0);
                        select id into v_acc_id from account where upper(email) = upper(:P9999_USERNAME);
                    end if;
                
                    APEX_UTIL.SET_SESSION_STATE('APP_USER_ACC_ID', v_acc_id);
                
                     BEGIN
                        SELECT id
                        INTO :P9999_PERS_ID
                        FROM personal_info
                        WHERE account_id = :APP_USER_ACC_ID;
                
                        APEX_UTIL.SET_SESSION_STATE('APP_USER_PERS_ID', :P9999_PERS_ID);
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            APEX_UTIL.SET_SESSION_STATE('APP_USER_PERS_ID', NULL);
                    END;
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        error {
            errorMessage: "&{INVALID_CREDENTIALS}."
        }
        advanced {
            executionMappingIdentifier: 17174137093907616
        }
    )

