page 133 (
    name: User Problem Form
    alias: USER-PROBLEM-FORM
    title: User Problem Form
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: https://www.google.com/recaptcha/api.js
    }
    css {
        inline:
            ```css
            /* .no-border-item input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                pointer-events: none;
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
            } */
            
            
            body {
                background-image: url("#APP_FILES#CareerBackGround4.jpg");
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            
            
            #my_region {
                margin-top: 300px;
            }
            
            
            
            /* Target your OTP container region */
            #my_region {
                background: rgba(240, 240, 240, 0.79) !important;
                backdrop-filter: blur(10px) !important;
                -webkit-backdrop-filter: blur(10px) !important;
                border: 1px solid rgba(56, 56, 56, 0.15) !important;
                border-radius: 12px !important;
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
            }
            
            /* Ensure header text is readable and header background is gone */
            #my_region .t-Region-header {
                background: transparent !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            }
            
            #my_region .t-Region-title {
                color: #000000ff !important;
                font-weight: 600;
            }
            
            /* Style the OTP text field */
            #P133_OTP {
                background: rgba(240, 240, 240, 0.96) !important;
                border: 1px solid rgba(36, 36, 36, 0.2) !important;
                color: #000000ff !important;
                border-radius: 6px !important;
                transition: all 0.3s ease;
            }
            
            /* Add a neon glow on focus */
            #P133_OTP:focus {
                border-color: #002b35ff !important;
                box-shadow: 0 0 10px rgba(0, 210, 255, 0.5) !important;
                background: rgba(240, 240, 240, 0.96) !important;
            }
            
            
            /* Primary Action (Verify) */
            .t-Button--hot {
                background: rgba(9, 8, 66, 1) !important;
                border: none !important;
                font-weight: bold !important;
                box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3) !important;
                transition: transform 0.2s, box-shadow 0.2s !important;
            }
            
            .t-Button--hot:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5) !important;
            }
            
            /* Secondary Action (Back) */
            .t-Button {
                /* background: transparent !important; */
                color: rgba(255, 255, 255, 0.7) !important;
                border: 1px solid rgba(255, 255, 255, 0.3) !important;
            }
            
            .t-Button:hover {
                color: #000000ff !important;
                border-color: #ffffff !important;
                background: rgba(255, 255, 255, 0.05) !important;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region email (
        name: Email
        title: Enter Your Email
        type: staticContent
        layout {
            sequence: 40
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: my_region
        }
        serverSideCondition {
            type: item=value
            item: P133_REGION_CHECK
            value: 0
        }
    )

    region otp (
        name: Problems
        title: Enter Your Problem
        type: staticContent
        layout {
            sequence: 30
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: my_region
        }
        serverSideCondition {
            type: item!=value
            item: P133_REGION_CHECK
            value: 0
        }
    )

    region recaptcha (
        name: RECAPTCHA
        type: staticContent
        source {
            htmlCode: <div class="g-recaptcha" data-sitekey="&RECAPTCHAV2_SITE_KEY."></div>
        }
        layout {
            sequence: 70
            parentRegion: @otp
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
                t-Form--labelsAbove
                margin-top-md
                margin-bottom-lg
                margin-left-lg
            ]
        }
    )

    pageItem P133_ACCEPT (
        type: hidden
        layout {
            sequence: 90
            region: @otp
            slot: regionBody
        }
    )

    pageItem P133_EMAIL (
        type: textField
        label {
            label: Enter Your Email
            alignment: left
        }
        layout {
            sequence: 50
            region: @otp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P133_EMAIL_1 (
        type: textField
        label {
            label: Enter Your Email
            alignment: left
        }
        layout {
            sequence: 20
            region: @email
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P133_PASSWORD (
        type: hidden
        layout {
            sequence: 40
            region: @otp
            slot: regionBody
        }
    )

    pageItem P133_PROBLEM (
        type: textarea
        label {
            label: Enter Your Problem
            alignment: left
        }
        layout {
            sequence: 60
            region: @otp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P133_RECAPTCHA_RESPONSE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @recaptcha
            slot: regionBody
        }
    )

    pageItem P133_REGION_CHECK (
        type: hidden
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P133_RES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @recaptcha
            slot: regionBody
        }
    )

    button back (
        buttonName: Back
        label: back
        layout {
            sequence: 10
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
        }
    )

    button back_1 (
        buttonName: Back_1
        label: back
        layout {
            sequence: 10
            region: @email
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
        }
    )

    button verfiy-email (
        buttonName: Verfiy_Email
        label: "&{VERFIY}."
        layout {
            sequence: 30
            region: @email
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button verfiy-otp (
        buttonName: Submit_problem
        label: Submit
        layout {
            sequence: 80
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @verfiy-otp
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var response = grecaptcha.getResponse();
                    apex.item("P133_RECAPTCHA_RESPONSE").setValue(response);
                    // This removes it from POST completely.
                    $('textarea[name="g-recaptcha-response"]').removeAttr('name');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation validate-recaptcha (
        name: validate recaptcha
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_response   CLOB;
                    l_result     VARCHAR2(32767);
                BEGIN
                    apex_web_service.g_request_headers(1).name  := 'Content-Type';
                    apex_web_service.g_request_headers(1).value := 'application/x-www-form-urlencoded';
                
                    l_response := apex_web_service.make_rest_request(
                        p_url         => 'https://www.google.com/recaptcha/api/siteverify',
                        p_http_method => 'POST',
                        p_body        => 'secret='|| :RECAPTCHAV2_SECRETE_KEY
                                      || '&response=' || :P133_RECAPTCHA_RESPONSE
                    );
                
                    -- Check success
                 IF INSTR(l_response, '"success": true') = 0 THEN
                        return false;
                    END IF;
                
                
                :P133_RES := l_response;
                return true;
                END;
                ```
        }
        error {
            errorMessage: reCAPTCHA validation failed.
        }
        serverSideCondition {
            type: request=Value
            value: CHECK_MAIL_PASS
        }
    )

    process new (
        name: Verf_check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    USER_ACCOUNT_PACKAGE.Save_User_Problems(:P133_EMAIL, :P133_PROBLEM);
                
                    -- send email
                    APEX_MAIL.SEND(
                        p_to   => 'no-reply@eprom.com.eg',
                        p_from => 'apex@eprom.com.eg',
                        p_subj => 'User Problem',
                        p_body => 'User Email is: ' || :P133_EMAIL ||
                                  CHR(10) || 'and user problem is '  || :P133_PROBLEM
                    );
                
                    APEX_MAIL.PUSH_QUEUE;
                
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 112628212182378635
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-otp
        }
    )

    process new_2 (
        name: set region check item
        type: executeCode
        source {
            plsqlCode: :P133_REGION_CHECK := 1;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 112629081524378636
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-email
        }
        config {
            buildOption: @commented-out
        }
    )

    process verfication (
        name: Verfication
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_code VARCHAR2(6);
                BEGIN
                    -- generate 6-digit OTP
                    l_code := LPAD(TRUNC(DBMS_RANDOM.VALUE(0, 999999)), 6, '0');
                
                
                    IF :P133_EMAIL_1 IS NULL THEN
                    raise_application_error(-20002, 'Email is required');
                END IF;
                 -- Store email in application item
                    -- :G_VERIFICATION_EMAIL := :P133_EMAIL_1;
                
                    -- store code
                    INSERT INTO user_verification (email, code, expires_at)
                    VALUES (
                        :P133_EMAIL_1,
                        l_code,
                        SYSTIMESTAMP + INTERVAL '10' MINUTE
                    );
                
                    -- send email
                    APEX_MAIL.SEND(
                        p_to   => :P133_EMAIL_1,
                        p_from => 'apex@eprom.com.eg',
                        p_subj => 'Email Verification Code',
                        p_body => 'Your verification code is: ' || l_code ||
                                  CHR(10) || 'It expires in 10 minutes.'
                    );
                
                    APEX_MAIL.PUSH_QUEUE;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 112629447440378636
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-email
        }
        config {
            buildOption: @commented-out
        }
    )

    branch (
        name: redirect to login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
            }
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-otp
            type: itemIsNotZero
            item: P133_ACCEPT
        }
    )

)
