        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="recruitment-stage">
                
                    <h2>&{STAGE_1_APPLICATION}.</h2>
                
                    <p>
                        &{STAGE_1_APPLY_INTRO}.
                        <strong>&{CURRENT_VACANCIES}.</strong>&{STAGE_1_APPLY_OUTRO}.
