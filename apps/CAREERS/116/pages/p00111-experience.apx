page 111 (
    name: Experience
    alias: EXPERIENCE
    title: "&{EXPERIENCE}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region experience (
        name: Experience
        title: "&{EXPERIENCE}."
        type: form
        source {
            location: localDatabase
            tableName: JOB_APPLICATION_EXPERIENCE
        }
        layout {
            sequence: 10
            slot: body
            column: 3
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region personal-eperience (
        name: Personal_Eperience
        title: "&{PERSONALEPERIENCE}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select app_exp.ID,
                       app_exp.POSITION_NAME,
                       app_exp.COMPANY,
                       C.name as Country_name,
                       app_exp.OTHER_DETAILS,
                       app_exp.FROMDATE,
                       app_exp.TODATE
                  from JOB_APPLICATION_EXPERIENCE app_exp
                  join COUNTRY C on c.id = app_exp.COUNTRY_ID
                  
                  where personal_id = :APP_USER_PERS_ID;
                ```
        }
        layout {
            sequence: 20
            slot: body
            column: 3
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column COMPANY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: "&{COMPANY}."
            }
            layout {
                sequence: 30
            }
        )

        column COUNTRY_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: "&{COUNTRY_NAME}."
            }
            layout {
                sequence: 100
            }
        )

        column FROMDATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: "&{FROMDATE}."
            }
            layout {
                sequence: 40
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: "&{ID}."
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column OTHER_DETAILS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: "&{OTHER_DETAILS}."
            }
            layout {
                sequence: 50
            }
        )

        column POSITION_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: "&{POSITION_NAME}."
            }
            layout {
                sequence: 20
            }
        )

        column TODATE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: "&{TODATE}."
            }
            layout {
                sequence: 90
            }
        )

    )

    pageItem P111_COMPANY (
        type: textField
        label {
            label: "&{COMPANY}."
            alignment: left
        }
        layout {
            sequence: 30
            region: @experience
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        source {
            formRegion: @experience
            column: COMPANY
            dataType: clob
        }
    )

    pageItem P111_COUNTRY_ID (
        type: selectList
        label {
            label: "&{COUNTRY}."
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @country-name
        }
        layout {
            sequence: 80
            region: @experience
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @experience
            column: COUNTRY_ID
            dataType: number
        }
    )

    pageItem P111_EXP_CHECK (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P111_FROMDATE (
        type: datePicker
        label {
            label: "&{FROMDATE}."
            alignment: left
        }
        layout {
            sequence: 40
            region: @experience
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @experience
            column: FROMDATE
            dataType: date
        }
    )

    pageItem P111_ID (
        type: hidden
        layout {
            sequence: 10
            region: @experience
            slot: regionBody
        }
        source {
            formRegion: @experience
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P111_OTHER_DETAILS (
        type: textarea
        label {
            label: "&{OTHER_DETAILS}."
            alignment: left
        }
        layout {
            sequence: 60
            region: @experience
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        source {
            formRegion: @experience
            column: OTHER_DETAILS
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P111_PERSONAL_ID (
        type: hidden
        layout {
            sequence: 90
            region: @experience
            slot: regionBody
        }
        source {
            formRegion: @experience
            column: PERSONAL_ID
            dataType: number
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P111_PERSONAL_ID
        }
    )

    pageItem P111_POSITION_NAME (
        type: textField
        label {
            label: "&{POSITION_NAME}."
            alignment: left
        }
        layout {
            sequence: 20
            region: @experience
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        source {
            formRegion: @experience
            column: POSITION_NAME
            dataType: clob
        }
    )

    pageItem P111_TODATE (
        type: datePicker
        label {
            label: "&{TODATE}."
            alignment: left
        }
        layout {
            sequence: 50
            region: @experience
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @experience
            column: TODATE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: "&{CANCEL}."
        layout {
            sequence: 10
            region: @experience
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: "&{DELETE}."
        layout {
            sequence: 20
            region: @experience
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P111_ID
        }
    )

    button next (
        buttonName: Next
        label: "&{FINISH}."
        layout {
            sequence: 60
            region: @experience
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P111_ID
        }
    )

    button save (
        buttonName: SAVE
        label: "&{APPLY_CHANGES}."
        layout {
            sequence: 30
            region: @experience
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P111_ID
        }
    )

    button save-and-add-one (
        buttonName: save_and_add_one
        label: "&{SAVE}."
        layout {
            sequence: 50
            region: @experience
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @save-and-add-one
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @personal-eperience
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation comp-val (
        name: comp_val
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P111_COMPANY
        }
        error {
            errorMessage: "&{THE_FIELD_IS_REQUIRED}."
        }
        serverSideCondition {
            whenButtonPressed: @save-and-add-one
        }
    )

    validation country-val (
        name: country_val
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P111_COUNTRY_ID
        }
        error {
            errorMessage: "&{THE_FIELD_IS_REQUIRED}."
        }
        serverSideCondition {
            whenButtonPressed: @save-and-add-one
        }
    )

    validation exp-val (
        name: Exp_val
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotZero
            item: P111_EXP_CHECK
        }
        error {
            errorMessage: "&{ENTER_YOUR_EXPERIENCE_FIRST}."
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    validation fromdate-val (
        name: fromDate_val
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P111_FROMDATE
        }
        error {
            errorMessage: "&{THE_FIELD_IS_REQUIRED}."
        }
        serverSideCondition {
            whenButtonPressed: @save-and-add-one
        }
    )

    validation pos-name-val (
        name: Pos_name_val
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P111_POSITION_NAME
        }
        error {
            errorMessage: "&{THE_FIELD_IS_REQUIRED}."
        }
        serverSideCondition {
            whenButtonPressed: @save-and-add-one
        }
    )

    validation todate-val (
        name: toDate_val
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P111_TODATE
        }
        error {
            errorMessage: "&{THE_FIELD_IS_REQUIRED}."
        }
        serverSideCondition {
            whenButtonPressed: @save-and-add-one
        }
    )

    process exp-check (
        name: Exp_Check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    SELECT 1
                    INTO :P111_EXP_CHECK
                    FROM JOB_APPLICATION_EXPERIENCE
                    WHERE personal_id = :APP_USER_PERS_ID
                    FETCH FIRST 1 ROW ONLY;
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        :P111_EXP_CHECK := 0;
                END;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 344534427210844845
        }
    )

    process initialize-form-experience (
        name: Initialize form Experience
        type: formInitialization
        formRegion: @experience
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 342563384230268499
        }
    )

    process process-form-experience (
        name: Process form Experience
        type: formAutoRowProcessing
        formRegion: @experience
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 342563745074268500
        }
        serverSideCondition {
            whenButtonPressed: @save-and-add-one
        }
    )

    process set-p-id (
        name: set_p_id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P111_PERSONAL_ID := :APP_USER_PERS_ID;
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 338537071711033922
        }
    )

    branch (
        name: Go To Page 111
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 111
            }
        }
        serverSideCondition {
            whenButtonPressed: @save-and-add-one
        }
    )

    branch (
        name: Go To Page 1
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 104
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
