page 101 (
    name: OTP Validation
    alias: OTP-VALIDATION
    title: "&{OTP_VALIDATION}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* .no-border-item input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                pointer-events: none;
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
            } */
            
            
            body {
                background-image: url("#APP_FILES#CareerBackGround4.jpg");
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            
            
            #my_region {
                margin-top: 300px;
            }
            
            
            
            /* Target your OTP container region */
            #my_region {
                background: rgba(240, 240, 240, 0.79) !important;
                backdrop-filter: blur(10px) !important;
                -webkit-backdrop-filter: blur(10px) !important;
                border: 1px solid rgba(56, 56, 56, 0.15) !important;
                border-radius: 12px !important;
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
            }
            
            /* Ensure header text is readable and header background is gone */
            #my_region .t-Region-header {
                background: transparent !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            }
            
            #my_region .t-Region-title {
                color: #000000ff !important;
                font-weight: 600;
            }
            
            /* Style the OTP text field */
            #P101_OTP {
                background: rgba(240, 240, 240, 0.96) !important;
                border: 1px solid rgba(36, 36, 36, 0.2) !important;
                color: #000000ff !important;
                border-radius: 6px !important;
                transition: all 0.3s ease;
            }
            
            /* Add a neon glow on focus */
            #P101_OTP:focus {
                border-color: #002b35ff !important;
                box-shadow: 0 0 10px rgba(0, 210, 255, 0.5) !important;
                background: rgba(240, 240, 240, 0.96) !important;
            }
            
            
            /* Primary Action (Verify) */
            .t-Button--hot {
                background: rgba(9, 8, 66, 1) !important;
                border: none !important;
                font-weight: bold !important;
                box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3) !important;
                transition: transform 0.2s, box-shadow 0.2s !important;
            }
            
            .t-Button--hot:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5) !important;
            }
            
            /* Secondary Action (Back) */
            .t-Button {
                /* background: transparent !important; */
                color: rgba(255, 255, 255, 0.7) !important;
                border: 1px solid rgba(255, 255, 255, 0.3) !important;
            }
            
            .t-Button:hover {
                color: #000000ff !important;
                border-color: #ffffff !important;
                background: rgba(255, 255, 255, 0.05) !important;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region guide-message (
        name: guide message
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="guide-box">
                 
                    <div class="">
                        ⚠️
                    </div> 
                
                    <div class="guide-content">
                        <!-- <div class="guide-title">
                            User Guide
                        </div> -->
                
                        <p>
                           An OTP has been sent to your registered email. Please enter it below to verify your account.       
                        </p>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @otp
            slot: regionBody
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region otp (
        name: OTP
        title: Enter The Correct OTP
        type: staticContent
        layout {
            sequence: 30
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: my_region
        }
    )

    pageItem P101_ACCEPT (
        type: hidden
        layout {
            sequence: 70
            region: @otp
            slot: regionBody
        }
    )

    pageItem P101_EMAIL (
        type: hidden
        layout {
            sequence: 50
            region: @otp
            slot: regionBody
        }
    )

    pageItem P101_OTP (
        type: textField
        label {
            label: Enter The OTP
            alignment: left
        }
        layout {
            sequence: 30
            region: @otp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P101_PASSWORD (
        type: hidden
        layout {
            sequence: 40
            region: @otp
            slot: regionBody
        }
    )

    button back (
        buttonName: Back
        label: back
        layout {
            sequence: 20
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 100
            }
        }
    )

    button verfiy-otp (
        buttonName: Verfiy_OTP
        label: "&{VERFIY}."
        layout {
            sequence: 60
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process new (
        name: Verf_check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                     l_code VARCHAR2(6);
                    v_id number;
                begin
                
                    select id, code into v_id, l_code  from user_verification where lower(email) = lower(:P101_EMAIL) and is_used <> 1  
                    and EXPIRES_AT > SYSDATE order by created_at desc
                fetch first 1 row only;
                
                    if l_code = :P101_OTP then
                        user_account_package.register_new_user(:P101_EMAIL,:P101_PASSWORD);
                        :P101_ACCEPT := 1;
                        update user_verification set is_used = 1 where id = v_id;
                        commit;
                    else
                        raise_application_error(-20003, 'the code is not correct');
                    end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 17176437510907639
        }
    )

    process new_1 (
        name: New
        type: executeCode
        source {
            plsqlCode: :P101_EMAIL := :G_VERIFICATION_EMAIL;
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 44881667497969402
        }
        config {
            buildOption: @commented-out
        }
    )

    branch (
        name: redirect to login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
            }
        }
        serverSideCondition {
            type: itemIsNotZero
            item: P101_ACCEPT
        }
    )

)
