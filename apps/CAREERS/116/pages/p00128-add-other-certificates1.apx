page 128 (
    name: Add Other Certificates
    alias: ADD-OTHER-CERTIFICATES1
    title: "&{ADD_OTHER_CERTIFICATES}."
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region add-other-certificates (
        name: Add Other Certificates
        title: "&{ADD_OTHER_CERTIFICATES}."
        type: form
        source {
            location: localDatabase
            tableName: JOB_APPLICATION_CERTIFICATE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        title: "&{BUTTONS}."
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P128_CERTIFICATE_NAME (
        type: textarea
        label {
            label: "&{CERTIFICATE_NAME}."
            alignment: right
        }
        layout {
            sequence: 30
            region: @add-other-certificates
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @add-other-certificates
            column: CERTIFICATE_NAME
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P128_DATE_OF_ACQUISITION (
        type: datePicker
        label {
            label: "&{DATE_OF_ACQUISITION}."
            alignment: right
        }
        layout {
            sequence: 40
            region: @add-other-certificates
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @add-other-certificates
            column: DATE_OF_ACQUISITION
            dataType: date
        }
    )

    pageItem P128_ID (
        type: hidden
        layout {
            sequence: 10
            region: @add-other-certificates
            slot: regionBody
        }
        source {
            formRegion: @add-other-certificates
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P128_JOB_APPLICATION_ID (
        type: selectList
        label {
            label: "&{JOB_APPLICATION_ID}."
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @job-application-marital-status
        }
        layout {
            sequence: 20
            region: @add-other-certificates
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @add-other-certificates
            column: JOB_APPLICATION_ID
            dataType: number
        }
    )

    pageItem P128_PERSONAL_ID (
        type: hidden
        layout {
            sequence: 50
            region: @add-other-certificates
            slot: regionBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: "&{CANCEL}."
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: "&{CREATE}."
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P128_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: "&{DELETE}."
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P128_ID
        }
    )

    button save (
        buttonName: SAVE
        label: "&{APPLY_CHANGES}."
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P128_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 352593987953130646
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-add-other-certificates (
        name: Initialize form Add Other Certificates
        type: formInitialization
        formRegion: @add-other-certificates
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 352593198459130646
        }
    )

    process process-form-add-other-certificates (
        name: Process form Add Other Certificates
        type: formAutoRowProcessing
        formRegion: @add-other-certificates
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 352593598926130646
        }
    )

)
