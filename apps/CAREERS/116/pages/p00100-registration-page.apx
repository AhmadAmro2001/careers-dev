page 100 (
    name: Registration page
    alias: REGISTRATION-PAGE
    title: "&{REGISTRATION_PAGE}."
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .no-border-item input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                pointer-events: none;
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
            }
            
            body {
                background-image: url("#APP_FILES#CareerBackGround4.jpg");
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            
            
            /* Target your OTP container region */
            #my_region {
                background: rgba(240, 240, 240, 0.79) !important;
                backdrop-filter: blur(10px) !important;
                -webkit-backdrop-filter: blur(10px) !important;
                border: 1px solid rgba(56, 56, 56, 0.15) !important;
                border-radius: 12px !important;
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
            }
            
            /* Ensure header text is readable and header background is gone */
            #my_region .t-Region-header {
                background: transparent !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            }
            
            #my_region .t-Region-title {
                color: #000000ff !important;
                font-weight: 600;
            }
            
            /* Style the OTP text field */
            #P100_CONFIRM_PASS {
                background: rgba(240, 240, 240, 0.96) !important;
                border: 1px solid rgba(36, 36, 36, 0.2) !important;
                color: #000000ff !important;
                border-radius: 6px !important;
                transition: all 0.3s ease;
            }
            
            /* Add a neon glow on focus */
            #P100_CONFIRM_PASS:focus {
                border-color: #002b35ff !important;
                box-shadow: 0 0 10px rgba(0, 210, 255, 0.5) !important;
                background: rgba(240, 240, 240, 0.96) !important;
            }
            
            
            /* Style the OTP text field */
            #P100_PASSWORD {
                background: rgba(240, 240, 240, 0.96) !important;
                border: 1px solid rgba(36, 36, 36, 0.2) !important;
                color: #000000ff !important;
                border-radius: 6px !important;
                transition: all 0.3s ease;
            }
            
            /* Add a neon glow on focus */
            #P100_PASSWORD:focus {
                border-color: #002b35ff !important;
                box-shadow: 0 0 10px rgba(0, 210, 255, 0.5) !important;
                background: rgba(240, 240, 240, 0.96) !important;
            }
            
            
            /* Style the OTP text field */
            #P100_EMAIL {
                background: rgba(240, 240, 240, 0.96) !important;
                border: 1px solid rgba(36, 36, 36, 0.2) !important;
                color: #000000ff !important;
                border-radius: 6px !important;
                transition: all 0.3s ease;
            }
            
            /* Add a neon glow on focus */
            #P100_EMAIL:focus {
                border-color: #002b35ff !important;
                box-shadow: 0 0 10px rgba(0, 210, 255, 0.5) !important;
                background: rgba(240, 240, 240, 0.96) !important;
            }
            
            /* Primary Action (Verify) */
            #REGISTER--hot {
                background: rgba(9, 8, 66, 1) !important;
                border: none !important;
                font-weight: bold !important;
                box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3) !important;
                transition: transform 0.2s, box-shadow 0.2s !important;
            }
            
            #REGISTER--hot:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5) !important;
            }
            
            /* Secondary Action (Back) */
            #REGISTER {
                /* background: transparent !important; */
                background: rgba(9, 8, 66, 1) !important;
                color: rgba(255, 255, 255, 0.7) !important;
                border: 1px solid rgba(255, 255, 255, 0.3) !important;
            }
            
            #REGISTER:hover {
                color: #000000ff !important;
                border-color: #ffffff !important;
                background: rgba(9, 8, 66, 0.36) !important;
            
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region caution (
        name: caution
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="eprom-warning" style = "padding-top: 0px;">
                
                    <h3>   ⚠️ Caution </h3>
                
                    <p>
                        ⚠️ In our commitment to protecting citizens and maintaining our credibility,
                        EPROM strongly warns and fully disclaims any responsibility against fake entities,
                        individuals, online pages or phone numbers spreading misleading information falsely
                        claiming to act as intermediaries offering job opportunities in the name of EPROM.
                    </p>
                
                    <p><strong>The company affirms the following:</strong></p>
                
                    <ul>
                        <li>✅ There are no authorized intermediaries for offering job opportunities, whether inside or outside the country.</li>
                        <li>✅ All services and job opportunities are announced exclusively through the company’s official channels.</li>
                        <li>✅ All services are provided completely free of charge, with no fees or commissions whatsoever.</li>
                    </ul>
                
                    <p>
                        🚫 We urge everyone not to share any personal information with unknown parties
                        impersonating the company.
                    </p>
                
                    <p>
                        <strong>For your safety… Always verify through the EPROM official channels.</strong>
                    </p>
                
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Login-region--headerHidden js-removeLandmark
                margin-right-sm
            ]
        }
    )

    region guide-message (
        name: guide message
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="guide-box">
                    <!-- " -->
                    <div class="guide-icon">
                        <span class="fa fa-info-circle"></span>
                    </div>
                
                    <div class="guide-content">
                        <!-- <div class="guide-title">
                            User Guide
                        </div> -->
                
                        <p>
                            Please fill in all required fields with accurate information to create your account.        
                        </p>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @registration-page
            slot: regionBody
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region registration-page (
        name: Registration page
        title: "&{REGISTRATION}."
        type: form
        source {
            location: localDatabase
            tableName: ACCOUNT
        }
        layout {
            sequence: 30
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Login-region--headerHidden js-removeLandmark
                margin-left-sm
            ]
        }
        advanced {
            htmlDomId: my_region
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P100_CONFIRM_PASS (
        type: password
        label {
            label: "&{CONFIRM_PASSWORD}."
            alignment: left
        }
        layout {
            sequence: 60
            region: @registration-page
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            formRegion: @registration-page
            column: PASSWORD
            dataType: varchar2
        }
    )

    pageItem P100_EMAIL (
        type: textField
        label {
            label: "&{EMAIL}."
            alignment: left
        }
        layout {
            sequence: 40
            region: @registration-page
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @registration-page
            column: MOBILE_TELEPHONE
            dataType: varchar2
        }
    )

    pageItem P100_EMAIL_COUNT (
        type: hidden
        layout {
            sequence: 110
            region: @registration-page
            slot: regionBody
        }
    )

    pageItem P100_ID (
        type: hidden
        layout {
            sequence: 20
            region: @registration-page
            slot: regionBody
        }
        source {
            formRegion: @registration-page
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P100_OTP (
        type: hidden
        layout {
            sequence: 90
            region: @registration-page
            slot: regionBody
        }
    )

    pageItem P100_PASSWORD (
        type: password
        label {
            label: "&{PASSWORD}."
            alignment: left
        }
        layout {
            sequence: 50
            region: @registration-page
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            formRegion: @registration-page
            column: PASSWORD
            dataType: varchar2
        }
    )

    pageItem P100_TEXT (
        type: textField
        label {
            label: "&{ALREADY_HAVE_ACCOUNT}."
            alignment: left
        }
        layout {
            sequence: 80
            region: @registration-page
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: no-border-item
            width: 30
        }
        advanced {
            customAttributes: readonly
        }
        config {
            buildOption: @commented-out
        }
    )

    button cancel (
        buttonName: CANCEL
        label: "&{CANCEL}."
        layout {
            sequence: 10
            region: @registration-page
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    button create (
        buttonName: CREATE
        label: "&{REGISTER}."
        layout {
            sequence: 70
            region: @registration-page
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        advanced {
            htmlDomId: REGISTER
        }
        serverSideCondition {
            type: itemIsNull
            item: P100_ID
        }
    )

    button create-acc (
        buttonName: Create_acc
        label: Already have account?
        layout {
            sequence: 10
            region: @registration-page
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--link
            ]
            cssClasses: readonly
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 100
            }
        }
    )

    button delete (
        buttonName: DELETE
        label: "&{DELETE}."
        layout {
            sequence: 20
            region: @registration-page
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_ID
        }
    )

    button login (
        buttonName: Login
        label: "&{LOGIN}."
        layout {
            sequence: 20
            region: @registration-page
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--link
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button register (
        buttonName: Register
        label: "&{REGISTER}."
        layout {
            sequence: 100
            region: @registration-page
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: "&{APPLY_CHANGES}."
        layout {
            sequence: 30
            region: @registration-page
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_ID
        }
    )

    validation check-password (
        name: Check_Password
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P100_PASSWORD = :P100_CONFIRM_PASS
        }
        error {
            errorMessage: "&{THE_PASSWORD_AND_CONFIRM_PASSWORD_MUST_BE_THE_SAME}."
        }
    )

    validation email-val (
        name: Email_Val
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P100_EMAIL_COUNT = 0
        }
        error {
            errorMessage: This email already exists!
        }
    )

    validation pass-exp (
        name: pass_exp
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression:
                ```plsql
                LENGTH(:P1_PASSWORD) >= 8
                AND REGEXP_LIKE(:P1_PASSWORD, '[A-Z]')
                AND REGEXP_LIKE(:P1_PASSWORD, '[a-z]')
                AND REGEXP_LIKE(:P1_PASSWORD, '[0-9]')
                AND REGEXP_LIKE(:P1_PASSWORD, '[[:punct:]]')
                ```
        }
        error {
            errorMessage:
                ```
                Password must be at least 8 characters long and contain:
                - One uppercase letter
                - One lowercase letter
                - One number
                - One special character.
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process email-check (
        name: Email_Check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_count_email_check number;
                
                begin
                
                    select count(*) into v_count_email_check from account where upper(email) = upper(:P100_EMAIL);
                    :P100_EMAIL_COUNT := v_count_email_check;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 17177480159907649
        }
    )

    process initialize-form-registration-page (
        name: Initialize form Registration page
        type: formInitialization
        formRegion: @registration-page
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 335828706957221220
        }
    )

    process process-form-registration-page (
        name: Process form Registration page
        type: formAutoRowProcessing
        formRegion: @registration-page
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 335829139014221221
        }
        config {
            buildOption: @commented-out
        }
    )

    process register (
        name: Register
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- DECLARE
                --     v_otp NUMBER;
                -- BEGIN
                --     -- Generate OTP
                --     v_otp := TRUNC(DBMS_RANDOM.VALUE(100000, 999999));
                
                --     -- Store OTP + user data in session
                --     APEX_UTIL.SET_SESSION_STATE('P101_OTP_GENERATED', v_otp);
                --     APEX_UTIL.SET_SESSION_STATE('P101_PHONE', :P100_PHONE);
                --     APEX_UTIL.SET_SESSION_STATE('P101_PASSWORD', :P100_PASSWORD);
                
                --     -- Send OTP (replace with real API)
                --     UTL_HTTP.REQUEST(
                --         'https://api.smsprovider.com/send?to=' 
                --         || :P100_PHONE || '&msg=' || v_otp
                --     );
                -- END;
                
                
                
                
                
                begin
                user_account_package.register_new_user(:P100_Email,:P100_PASSWORD);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 315098787752516315
        }
        config {
            buildOption: @commented-out
        }
    )

    process verfication (
        name: Verfication
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_code VARCHAR2(6);
                BEGIN
                    -- generate 6-digit OTP
                    l_code := LPAD(TRUNC(DBMS_RANDOM.VALUE(0, 999999)), 6, '0');
                
                
                    IF :P100_EMAIL IS NULL THEN
                    raise_application_error(-20002, 'Email is required');
                END IF;
                
                
                    -- store code
                    INSERT INTO user_verification (email, code, expires_at)
                    VALUES (
                        :P100_EMAIL,
                        l_code,
                        SYSTIMESTAMP + INTERVAL '10' MINUTE
                    );
                
                    -- send email
                    APEX_MAIL.SEND(
                        p_to   => :P100_EMAIL,
                        p_from => 'apex@eprom.com.eg',
                        p_subj => 'Email Verification Code',
                        p_body => 'Your verification code is: ' || l_code ||
                                  CHR(10) || 'It expires in 10 minutes.'
                    );
                
                    APEX_MAIL.PUSH_QUEUE;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 17176394689907638
        }
    )

    branch (
        name: Go To Page 1
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 101
                items: {
                    P101_EMAIL: &P100_EMAIL.
                    P101_PASSWORD: &P100_PASSWORD.
                }
            }
        }
    )

)
