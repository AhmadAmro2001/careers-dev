                ```sql
                select "ID","ACCOUNT_ID",sys.dbms_lob.getlength("NATIONAL_ID_IMAGE")"NATIONAL_ID_IMAGE","MOTHER_FULL_NAME","MARITAL_STATUS","MILITARY_STATUS","PASSORT_NUMBER","NAT_ID_FILE_NAME"from "PERSONAL_INFO"
                where "ID" = :APP_USER_PERS_ID;
