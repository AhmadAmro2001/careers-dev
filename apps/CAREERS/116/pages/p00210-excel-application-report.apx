page 210 (
    name: Excel Application Report
    alias: EXCEL-APPLICATION-REPORT
    title: "&{EXCEL_APPLICATION_REPORT}."
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            apex.server.process("CHECK_REPORT_COUNT", {
              pageItems: "#P210_VACANCY_ID"
            }, {
              dataType: "json",
              success: function(data) {
                console.log("Ajax result:", data);
            
                var btn = $("#DOWNLOAD_RESUMES");
            
                console.log("Button found:", btn.length);
            
                if (data.status === "DISABLE") {
                  btn
                    .attr("disabled", "disabled")
                    .addClass("is-disabled")
                    .css({
                      "pointer-events": "none",
                      "opacity": "0.5",
                      "cursor": "not-allowed"
                    });
                } else {
                  btn
                    .removeAttr("disabled")
                    .removeClass("is-disabled")
                    .css({
                      "pointer-events": "",
                      "opacity": "",
                      "cursor": ""
                    });
                }
              }
            });
            ```
    }
    css {
        inline:
            ```css
            .a-IRR-table td[headers="EXPERIENCE_DETAILS"] {
                white-space: pre-line;
            }
            
            
            #DOWNLOAD_RESUMES.is-disabled {
              opacity: 0.5;
              pointer-events: none;
              cursor: not-allowed;
            }
            ```
    }
    security {
        authorizationScheme: @admin-schema
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region excel-download (
        name: Excel Download
        title: "&{EXCEL_DOWNLOAD}."
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with
                params as (
                    select to_number(
                               trim(:P210_VACANCY_ID)
                               default null on conversion error
                           ) as vacancy_id
                    from dual
                ),
                application_base as (
                    select /*+ materialize */
                           j.id,
                           j.account_id,
                           j.resume_file_id,
                           j.creation_date
                    from job_application j
                    join account u
                      on u.id = j.account_id
                    cross join params p
                    where (
                        exists (
                            select 1
                            from apex_collections c
                            where c.collection_name = 'SELECTED_APPLICATIONS'
                              and c.n001 = j.id
                        )
                        or not exists (
                            select 1
                            from apex_collections c
                            where c.collection_name = 'SELECTED_APPLICATIONS'
                        )
                    )
                    and (
                        p.vacancy_id is null
                        or exists (
                            select 1
                            from job_vacancy_application jva
                            where jva.application_id = j.id
                              and jva.vacancy_id = p.vacancy_id
                        )
                    )
                ),
                latest_education as (
                    select *
                    from (
                        select
                            ed.*,
                            row_number() over (
                                partition by ed.personal_id
                                order by ed.id desc
                            ) as rn
                        from education_degree ed
                        join personal_info pi
                          on pi.id = ed.personal_id
                        where exists (
                            select 1
                            from application_base a
                            where a.account_id = pi.account_id
                        )
                    )
                    where rn = 1
                ),
                application_personals as (
                    select distinct
                           pi.id as personal_id
                    from application_base a
                    join personal_info pi
                      on pi.account_id = a.account_id
                ),
                experience_by_person as (
                    select
                        e.personal_id,
                        xmlagg(
                            xmlelement(
                                line,
                                regexp_replace(
                                    to_char(e.fromdate, 'dd/mm/yyyy')
                                    || ' - '
                                    || nvl(to_char(e.todate, 'dd/mm/yyyy'), 'Present')
                                    || ' | '
                                    || e.position_name
                                    || ' | '
                                    || e.company
                                    || case
                                           when e.other_details is not null
                                           then ' | ' || e.other_details
                                           else null
                                       end,
                                    '[[:cntrl:]]',
                                    ' '
                                )
                                || chr(10)
                            )
                            order by e.fromdate desc
                        ).extract('//text()').getclobval() as experience_details
                    from job_application_experience e
                    join application_personals p
                      on p.personal_id = e.personal_id
                    group by e.personal_id
                )
                select
                    a.id,
                    u.id as account_id,
                    u.first_name || ' ' || u.second_name || ' ' || u.last_name as full_name,
                    u.national_id,
                    u.date_of_birth,
                    u.mobile_telephone || '/' || u.home_telephone as phone_numbers,
                    u.city,
                    ed.university,
                    el.name,
                    ed.graduation_year,
                    ef.name as field,
                
                    case
                        when el.name in ('Doctorate Degree', 'Master''s Degree')
                        then el.name
                        else 'N/A'
                    end as higher_degree,
                
                    case
                        when el.name in ('Doctorate Degree', 'Master''s Degree')
                        then to_char(ed.graduation_year)
                        else 'N/A'
                    end as higher_degree_year,
                
                    u.email,
                    e.experience_details
                
                from application_base a
                join account u
                  on u.id = a.account_id
                cross join params p
                
                left join personal_info pi
                  on pi.account_id = a.account_id
                
                left join latest_education ed
                  on ed.personal_id = pi.id
                
                left join education_level el
                  on el.id = ed.education_level
                
                left join education_field ef
                  on ef.id = ed.education_field
                
                left join experience_by_person e
                  on e.personal_id = pi.id
                
                left join job_vacancy_application jva
                  on jva.application_id = a.id
                 and (
                     p.vacancy_id is null
                     or jva.vacancy_id = p.vacancy_id
                 )
                
                left join job_application_attachments jaa
                  on jaa.id = a.resume_file_id
                 and jaa.file_type_id = 2
                
                order by a.creation_date desc
                
                
                -- select j.ID, 
                --        u.ID as account_id,
                --        u.FIRST_NAME || ' ' || u.SECOND_NAME || ' ' || u.LAST_NAME as FULL_NAME,
                --        u.NATIONAL_ID ,
                --        u.DATE_OF_BIRTH ,
                --        u.MOBILE_TELEPHONE || '/' || u.HOME_TELEPHONE as phone_numbers,
                --        u.CITY,
                --        ed.UNIVERSITY,
                --        el.NAME,
                --        ed.GRADUATION_YEAR,
                --        ef.name as field,
                --        case
                --             when el.name in ('Doctorate Degree', 'Master''s Degree') then el.name
                --             else 'N/A'
                --        end as higher_degree,
                --        case
                --             when el.name in ('Doctorate Degree', 'Master''s Degree') then to_char(ed.graduation_year)
                --             else 'N/A'
                --        end as higher_degree_year,
                --        u.EMAIL,
                --     --    jae.FROMDATE,
                --     --    jae.TODATE,
                --     --    jae.POSITION_NAME,
                --     --    jae.COMPANY,
                --     --    jae.OTHER_DETAILS
                --         jae.experience_details  
                       
                
                       
                
                
                       
                
                      
                
                -- from Job_Application j
                -- join Account u
                -- on u.ID = j.ACCOUNT_ID
                -- left join personal_info pi
                --    on pi.Account_ID = j.Account_ID
                -- -- left join education_degree ed
                -- --     on ed.job_application_id = j.id
                -- left join (
                --     select *
                --     from (
                --         select 
                --                ed.*,
                --                row_number() over (
                --                    partition by ed.personal_id
                --                    order by ed.id desc
                --                ) as rn
                --         from education_degree ed
                --     )
                --     where rn = 1
                -- ) ed
                --     on pi.id = ed.personal_id
                -- left join education_level el
                --     on ed.education_level = el.id
                -- left join education_field ef
                --     on ef.id = ed.education_field
                -- -- left join job_application_experience jae
                -- --     on jae.job_application_id = j.id
                -- left join (
                --     select
                --         jae.personal_id,
                --         listagg(
                --             to_char(jae.fromdate, 'dd/mm/yyyy')
                --             || ' - ' ||
                --             nvl(to_char(jae.todate, 'dd/mm/yyyy'), 'Present')
                --             || ' | ' ||
                --             jae.position_name
                --             || ' | ' ||
                --             jae.company
                --             || case
                --                 when jae.other_details is not null then ' | ' || jae.other_details
                --                 else null
                --                end,
                --             chr(10)
                --         ) within group (order by jae.fromdate desc) as experience_details
                --     from job_application_experience jae
                --     group by jae.personal_id
                -- ) jae
                --     on jae.personal_id = pi.id
                -- left join Job_Vacancy_Application jva
                -- on jva.APPLICATION_ID = j.ID
                -- left join JOB_APPLICATION_ATTACHMENTS jaa
                -- on j.RESUME_FILE_ID = jaa.id and jaa.FILE_TYPE_ID = 2
                -- -- jat.id = j.RESUME_FILE_ID
                -- where (
                --     exists (
                --         select 1
                --         from apex_collections c
                --         where c.collection_name = 'SELECTED_APPLICATIONS'
                --         and c.n001 = j.id
                --     )
                --     or not exists (
                --         select 1
                --         from apex_collections c
                --         where c.collection_name = 'SELECTED_APPLICATIONS'
                --     )
                -- )
                
                -- and (
                --     :P210_VACANCY_ID is null
                --     or jva.vacancy_id = :P210_VACANCY_ID
                -- )
                
                -- order by j.CREATION_DATE desc
                -- ;
                
                
                ```
            pageItemsToSubmit: P210_VACANCY_ID
        }
