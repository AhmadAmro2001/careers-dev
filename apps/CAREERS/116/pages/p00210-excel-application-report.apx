    process check-report-count (
        name: CHECK_REPORT_COUNT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_count NUMBER;
                BEGIN
                
                    SELECT COUNT(DISTINCT j.id)
                    INTO l_count
                    FROM job_application j
                
                    LEFT JOIN job_vacancy_application jva
                        ON jva.application_id = j.id
                
                    LEFT JOIN job_application_attachments jaa
                        ON jaa.job_application_id = j.id
                       AND jaa.file_type_id = 2
                
                    WHERE
                        (
                            EXISTS (
                                SELECT 1
                                FROM apex_collections c
                                WHERE c.collection_name = 'SELECTED_APPLICATIONS'
                                AND c.n001 = j.id
                            )
                            OR
                            NOT EXISTS (
                                SELECT 1
                                FROM apex_collections c
                                WHERE c.collection_name = 'SELECTED_APPLICATIONS'
                            )
                        )
                
                        AND jaa.id IS NOT NULL
                
                        AND (
                            :P210_VACANCY_ID IS NULL
                            OR jva.vacancy_id = :P210_VACANCY_ID
                        );
                
                    apex_json.open_object;
                
                    apex_json.write(
                        'status',
                        CASE
                            WHEN l_count > 500 THEN 'DISABLE'
                            ELSE 'ENABLE'
                        END
                    );
                
                    apex_json.write(
                        'count',
                        l_count
                    );
                
                    apex_json.close_object;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 341529646710672524
        }
    )

