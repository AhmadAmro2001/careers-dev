page 2 (
    name: OTP Validation Forget Password
    alias: OTP-VALIDATION-FORGET-PASSWORD
    title: OTP Validation Forget Password
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* .no-border-item input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                pointer-events: none;
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
            } */
            
            
            body {
                background-image: url("#APP_FILES#CareerBackGround4.jpg");
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            
            
            #my_region {
                margin-top: 300px;
            }
            
            
            
            /* Target your OTP container region */
            #my_region {
                background: rgba(240, 240, 240, 0.79) !important;
                backdrop-filter: blur(10px) !important;
                -webkit-backdrop-filter: blur(10px) !important;
                border: 1px solid rgba(56, 56, 56, 0.15) !important;
                border-radius: 12px !important;
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
            }
            
            /* Ensure header text is readable and header background is gone */
            #my_region .t-Region-header {
                background: transparent !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            }
            
            #my_region .t-Region-title {
                color: #000000ff !important;
                font-weight: 600;
            }
            
            /* Style the OTP text field */
            #P2_OTP {
                background: rgba(240, 240, 240, 0.96) !important;
                border: 1px solid rgba(36, 36, 36, 0.2) !important;
                color: #000000ff !important;
                border-radius: 6px !important;
                transition: all 0.3s ease;
            }
            
            /* Add a neon glow on focus */
            #P2_OTP:focus {
                border-color: #002b35ff !important;
                box-shadow: 0 0 10px rgba(0, 210, 255, 0.5) !important;
                background: rgba(240, 240, 240, 0.96) !important;
            }
            
            
            /* Primary Action (Verify) */
            .t-Button--hot {
                background: rgba(9, 8, 66, 1) !important;
                border: none !important;
                font-weight: bold !important;
                box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3) !important;
                transition: transform 0.2s, box-shadow 0.2s !important;
            }
            
            .t-Button--hot:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5) !important;
            }
            
            /* Secondary Action (Back) */
            .t-Button {
                /* background: transparent !important; */
                color: rgba(255, 255, 255, 0.7) !important;
                border: 1px solid rgba(255, 255, 255, 0.3) !important;
            }
            
            .t-Button:hover {
                color: #000000ff !important;
                border-color: #ffffff !important;
                background: rgba(255, 255, 255, 0.05) !important;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region email (
        name: Email
        title: Enter Your Email
        type: staticContent
        layout {
            sequence: 40
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: my_region
        }
        serverSideCondition {
            type: item=value
            item: P2_REGION_CHECK
            value: 0
        }
    )

    region otp (
        name: OTP
        title: Enter The Correct OTP
        type: staticContent
        layout {
            sequence: 30
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: my_region
        }
        serverSideCondition {
            type: item!=value
            item: P2_REGION_CHECK
            value: 0
        }
    )

    pageItem P2_ACCEPT (
        type: hidden
        layout {
            sequence: 70
            region: @otp
            slot: regionBody
        }
    )

    pageItem P2_EMAIL (
        type: hidden
        layout {
            sequence: 50
            region: @otp
            slot: regionBody
        }
    )

    pageItem P2_EMAIL_1 (
        type: textField
        label {
            label: Enter Your Email
            alignment: left
        }
        layout {
            sequence: 20
            region: @email
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P2_OTP (
        type: textField
        label {
            label: Enter The OTP
            alignment: left
        }
        layout {
            sequence: 30
            region: @otp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P2_PASSWORD (
        type: hidden
        layout {
            sequence: 40
            region: @otp
            slot: regionBody
        }
    )

    pageItem P2_REGION_CHECK (
        type: hidden
        layout {
            sequence: 50
            slot: body
        }
    )

    button back (
        buttonName: Back
        label: back
        layout {
            sequence: 10
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
        }
    )

    button back_1 (
        buttonName: Back_1
        label: back
        layout {
            sequence: 10
            region: @email
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
        }
    )

    button verfiy-email (
        buttonName: Verfiy_Email
        label: "&{VERFIY}."
        layout {
            sequence: 30
            region: @email
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button verfiy-otp (
        buttonName: Verfiy_OTP
        label: "&{VERFIY}."
        layout {
            sequence: 60
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process new (
        name: Verf_check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                     l_code VARCHAR2(6);
                    v_id number;
                begin
                
                    select id, code into v_id, l_code  from user_verification where lower(email) = lower(:P2_EMAIL_1) and is_used <> 1  
                    and EXPIRES_AT > SYSDATE order by created_at desc
                fetch first 1 row only;
                
                    if l_code = :P2_OTP then
                        :P2_ACCEPT := 1;
                        update user_verification set is_used = 1 where id = v_id;
                        commit;
                    else
                        raise_application_error(-20003, 'the code is not correct');
                    end if;
                
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 44880720053959941
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-otp
        }
    )

    process new_1 (
        name: New
        type: executeCode
        source {
            plsqlCode: :P2_EMAIL := :G_VERIFICATION_EMAIL;
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 44881822749969404
        }
    )

    process new_2 (
        name: set region check item
        type: executeCode
        source {
            plsqlCode: :P2_REGION_CHECK := 1;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 43734948792689244
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-email
        }
    )

    process verfication (
        name: Verfication
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_code VARCHAR2(6);
                BEGIN
                    -- generate 6-digit OTP
                    l_code := LPAD(TRUNC(DBMS_RANDOM.VALUE(0, 999999)), 6, '0');
                
                
                    IF :P2_EMAIL_1 IS NULL THEN
                    raise_application_error(-20002, 'Email is required');
                END IF;
                 -- Store email in application item
                    -- :G_VERIFICATION_EMAIL := :P2_EMAIL_1;
                
                    -- store code
                    INSERT INTO user_verification (email, code, expires_at)
                    VALUES (
                        :P2_EMAIL_1,
                        l_code,
                        SYSTIMESTAMP + INTERVAL '10' MINUTE
                    );
                
                    -- send email
                    APEX_MAIL.SEND(
                        p_to   => :P2_EMAIL_1,
                        p_from => 'apex@eprom.com.eg',
                        p_subj => 'Email Verification Code',
                        p_body => 'Your verification code is: ' || l_code ||
                                  CHR(10) || 'It expires in 10 minutes.'
                    );
                
                    APEX_MAIL.PUSH_QUEUE;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 45063046104861533
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-email
        }
    )

    branch (
        name: redirect to login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 106
                items: {
                    P106_EMAIL: &P2_EMAIL_1.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @verfiy-otp
            type: itemIsNotZero
            item: P2_ACCEPT
        }
    )

)
