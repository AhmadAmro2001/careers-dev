page 15 (
    name: vacancy per category test
    alias: VACANCY-PER-CATEGORY-TEST
    title: "&{VACANCY_PER_CATEGORY_TEST}."
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region vacancy-per-category-test (
        name: vacancy per category test
        title: "&{VACANCY_PER_CATEGORY_TEST}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       TITLE
                  from JOB_VACANCY where category_id = :P15_CATEGORY_ID;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: "&{NO_DATA_FOUND_1}."
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 0
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: "&{TITLE}."
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    pageItem P15_CATEGORY_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)
