page 102 (
    name: OTP Validation Login
    alias: OTP-VALIDATION-LOGIN
    title: "&{OTP_LOGIN_VALIDATION}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#careers#MIN#.css
        inline:
            ```css
            /* .no-border-item input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                outline: none !important;
                pointer-events: none;
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
            } */
            
            
            body {
                background-image: url("#APP_FILES#CareerBackGround4.jpg");
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            
            
            #my_region {
                margin-top: 300px;
            }
            
            
            
            /* Target your OTP container region */
            #my_region {
                background: rgba(240, 240, 240, 0.79) !important;
                backdrop-filter: blur(10px) !important;
                -webkit-backdrop-filter: blur(10px) !important;
                border: 1px solid rgba(56, 56, 56, 0.15) !important;
                border-radius: 12px !important;
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
            }
            
            /* Ensure header text is readable and header background is gone */
            #my_region .t-Region-header {
                background: transparent !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            }
            
            #my_region .t-Region-title {
                color: #000000ff !important;
                font-weight: 600;
            }
            
            /* Style the OTP text field */
            #P102_OTP {
                background: rgba(240, 240, 240, 0.96) !important;
                border: 1px solid rgba(36, 36, 36, 0.2) !important;
                color: #000000ff !important;
                border-radius: 6px !important;
                transition: all 0.3s ease;
            }
            
            /* Add a neon glow on focus */
            #P102_OTP:focus {
                border-color: #002b35ff !important;
                box-shadow: 0 0 10px rgba(0, 210, 255, 0.5) !important;
                background: rgba(240, 240, 240, 0.96) !important;
            }
            
            
            /* Primary Action (Verify) */
            .t-Button--hot {
                background: rgba(9, 8, 66, 1) !important;
                border: none !important;
                font-weight: bold !important;
                box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3) !important;
                transition: transform 0.2s, box-shadow 0.2s !important;
            }
            
            .t-Button--hot:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5) !important;
            }
            
            /* Secondary Action (Back) */
            .t-Button {
                /* background: transparent !important; */
                color: rgba(255, 255, 255, 0.7) !important;
                border: 1px solid rgba(255, 255, 255, 0.3) !important;
            }
            
            .t-Button:hover {
                color: #000000ff !important;
                border-color: #ffffff !important;
                background: rgba(255, 255, 255, 0.05) !important;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region guide-message (
        name: guide message
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="guide-box">
                 
                    <div class="">
                        ⚠️
                    </div> 
                
                    <div class="guide-content">
                        <!-- <div class="guide-title">
                            User Guide
                        </div> -->
                
                        <p>
                            ⚠️ &{OTP_LOGIN_GUIDANCE}.
                        </p>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @otp
            slot: regionBody
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region otp (
        name: OTP
        title: "&{ENTER_CORRECT_OTP}."
        type: staticContent
        layout {
            sequence: 30
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: my_region
        }
    )

    pageItem P102_ACCEPT (
        type: hidden
        layout {
            sequence: 80
            region: @otp
            slot: regionBody
        }
    )

    pageItem P102_EMAIL (
        type: hidden
        layout {
            sequence: 60
            region: @otp
            slot: regionBody
        }
    )

    pageItem P102_OTP (
        type: textField
        label {
            label: "&{ENTER_OTP}."
            alignment: left
        }
        layout {
            sequence: 40
            region: @otp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P102_PASSWORD (
        type: hidden
        layout {
            sequence: 50
            region: @otp
            slot: regionBody
        }
    )

    pageItem P102_PERS_ID_CHECK (
        type: hidden
        layout {
            sequence: 90
            region: @otp
            slot: regionBody
        }
    )

    button back (
        buttonName: Back
        label: "&{BACK}."
        layout {
            sequence: 30
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
        }
    )

    button verfiy-otp (
        buttonName: Verfiy_OTP
        label: "&{VERFIY}."
        layout {
            sequence: 70
            region: @otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process new (
        name: Verf_check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                     l_code VARCHAR2(6);
                    v_id number;
                begin
                
                    select id, code into v_id, l_code  from user_verification where lower(email) = lower(:P102_EMAIL) and is_used <> 1  
                    and EXPIRES_AT > SYSDATE order by created_at desc
                fetch first 1 row only;
                
                    if l_code = :P102_OTP then
                        -- user_account_package.register_new_user(:P102_EMAIL,:P102_PASSWORD);
                        :P102_ACCEPT := 1;
                        update user_verification set is_used = 1 where id = v_id;
                        IF :G_USER_ROLE  = 1 THEN
                       
                            APEX_UTIL.SET_SESSION_STATE('G_UI_LANGUAGE', 'en', p_commit => FALSE);
                            APEX_UTIL.SET_SESSION_LANG('en');
                            apex_util.redirect_url('f?p=&APP_ID.:202:&SESSION.');
                        
                        ELSIF :G_USER_ROLE = 0 THEN
                        if :P102_PERS_ID_CHECK = 0 then
                            apex_util.redirect_url('f?p=&APP_ID.:119:&SESSION.');
                        else
                            apex_util.redirect_url('f?p=&APP_ID.:131:&SESSION.');
                        end if;
                    ELSE
                        apex_util.redirect_url('f?p=&APP_ID.:9999:&SESSION.'); -- fallback page
                    END IF;
                
                        
                    else
                        raise_application_error(-20003, APEX_LANG.GET_MESSAGE('INVALID_OTP'));
                    end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 113299631353433462
        }
    )

    process new_1 (
        name: New
        type: executeCode
        source {
            plsqlCode: :P102_EMAIL := :G_VERIFICATION_EMAIL;
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 113300036134433465
        }
        config {
            buildOption: @commented-out
        }
    )

    process redirect (
        name: Redirect
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                BEGIN
                -- raise_application_error(-20111,:G_USER_ROLE);
                    IF :G_USER_ROLE  = 1 THEN
                       
                        
                            apex_util.redirect_url('f?p=&APP_ID.:202:&SESSION.');
                        
                    ELSIF :G_USER_ROLE = 0 THEN
                        if :P102_PERS_ID_CHECK = 0 then
                            apex_util.redirect_url('f?p=&APP_ID.:119:&SESSION.');
                        else
                            apex_util.redirect_url('f?p=&APP_ID.:131:&SESSION.');
                        end if;
                    ELSE
                        apex_util.redirect_url('f?p=&APP_ID.:9999:&SESSION.'); -- fallback page
                    END IF;
                
                
                
                    
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 111453812590921015
        }
        config {
            buildOption: @commented-out
        }
    )

    branch (
        name: redirect to login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
            }
        }
        serverSideCondition {
            type: itemIsNotZero
            item: P102_ACCEPT
        }
        config {
            buildOption: @commented-out
        }
    )

)
