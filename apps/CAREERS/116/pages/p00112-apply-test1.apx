page 112 (
    name: Apply test
    alias: APPLY-TEST1
    title: "&{APPLY_TEST}."
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* ========================================================== */
            /* CUSTOM NAVBAR                                               */
            /* ========================================================== */
            
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            
                background: rgb(233, 233, 233);
            
                padding: 14px 24px;
            
                border-radius: 18px;
            
                box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            
                margin-bottom: 20px;
            }
            
            /* Left Links */
            .nav-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            
            /* Nav Links */
            .nav-link {
                display: flex;
                align-items: center;
                gap: 8px;
            
                text-decoration: none;
            
                color: #334155;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Hover */
            .nav-link:hover {
                background: rgb(232, 244, 255);
                color: #0563bb;
            }
            
            /* Logout Button */
            .logout-btn {
                display: flex;
                align-items: center;
                gap: 8px;
            
                background: #ef4444;
            
                color: white !important;
            
                text-decoration: none;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Logout Hover */
            .logout-btn:hover {
                background: #dc2626;
                transform: translateY(-1px);
            }
            
            /* Icons */
            .custom-navbar .fa {
                font-size: 14px;
            }
            
            
            [data-header="National Id Image"] img,
            [data-header="NATIONAL_ID_IMAGE"] img {
                width: 300px !important;
                height: 100px !important;
            }
            
            
            img {
                width: 250px !important;
                height: 100px !important;
                object-fit: cover;
                border-radius: 10px;
            }
            
            .nav-right {
                display: flex;
                align-items: center;
                gap: 15px;
            }
            
            .user-name {
                color: #333;
                font-weight: 600;
            }
            
            
            /* Make navbar wrap on small screens */
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap; /* مهم جداً */
            }
            
            /* Mobile & small tablets */
            @media (max-width: 768px) {
                .custom-navbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 12px;
                }
            
                .nav-left,
                .nav-right {
                    width: 100%;
                    justify-content: flex-start;
                    flex-wrap: wrap;
                }
            
                .nav-link,
                .logout-btn {
                    width: 100%;
                    justify-content: center;
                }
            
                .user-name {
                    width: 100%;
                    text-align: left;
                }
            }
            
            /* Very small screens (phones) */
            @media (max-width: 480px) {
                .nav-link,
                .logout-btn {
                    padding: 12px;
                    font-size: 14px;
                }
            
                .custom-navbar {
                    padding: 12px;
                }
            }
            
            
            
            /* Style all job detail regions */
            #job-summary,
            #project-description,
            #responsibilities,
            #qualifications,
            #benefits,
            #skills{
            
                background:#ffffff;
                border-left:6px solid #1565C0;
                border-radius:18px;
                padding:30px;
                margin-bottom:30px;
            
                box-shadow:0 8px 20px rgba(0,0,0,.08);
            
                transition:.3s;
            }
            
            /* Hover effect */
            #job-summary:hover,
            #project-description:hover,
            #responsibilities:hover,
            #qualifications:hover,
            #benefits:hover,
            #skills:hover{
            
                transform:translateY(-3px);
                box-shadow:0 12px 28px rgba(0,0,0,.12);
            
            }
            
            #job-summary .t-Region-title,
            #project-description .t-Region-title,
            #responsibilities .t-Region-title,
            #qualifications .t-Region-title,
            #benefits .t-Region-title,
            #skills .t-Region-title{
            
                color:#1565C0;
                font-size:28px;
                font-weight:700;
                text-align:center;
                text-transform:uppercase;
                letter-spacing:1px;
            }
            
            
            #job-summary .t-Region-title::after,
            #project-description .t-Region-title::after,
            #responsibilities .t-Region-title::after,
            #qualifications .t-Region-title::after,
            #benefits .t-Region-title::after,
            #skills .t-Region-title::after{
            
                content:"";
                display:block;
                width:80px;
                height:4px;
                background:#1565C0;
                margin:12px auto 0;
                border-radius:5px;
            
            }
            
            
            #job-summary,
            #project-description,
            #responsibilities,
            #qualifications,
            #benefits,
            #skills{
            
                font-size:16px;
                color:#444;
                line-height:1.9;
                font-family:"Segoe UI",sans-serif;
            
            }
            
            
            .no-word-break {
                white-space: normal !important;
                word-break: keep-all !important;
                overflow-wrap: normal !important;
                word-wrap: normal !important;
                hyphens: manual !important;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region job-summary (
        name: Job_summary
        title: "&{JOB_DETAILS}."
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: job-summary
        }
    )

    region navbar (
        name: navbar
        title: "&{NAVBAR}."
        type: appTemplateComponent/appliocantNavbar
        layout {
            sequence: 10
            slot: contentBody
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            display: regionOnly
        }
        settings {
            personalCheck: &PERSONAL_CHECK.
        }
    )

    pageItem P112_COMPLETE_PI (
        type: hidden
        layout {
            sequence: 130
            slot: contentBody
        }
    )

    pageItem P112_DETAILS_FLG (
        type: hidden
        layout {
            sequence: 150
            slot: contentBody
        }
    )

    pageItem P112_EDUCATION_LEVEL (
        type: displayOnly
        label {
            label: "&{MINIMUM_EDUCATION_LEVEL}."
            alignment: left
        }
        layout {
            sequence: 40
            region: @job-summary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: no-word-break
        }
        advanced {
            cssClasses: no-word-break
        }
    )

    pageItem P112_JOB_SUMMARY (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 10
            region: @job-summary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: no-word-break
        }
        advanced {
            cssClasses: no-word-break
        }
    )

    pageItem P112_JOB_TITLE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P112_JOB_VACANCY_CHECK (
        type: hidden
        layout {
            sequence: 120
            slot: contentBody
        }
    )

    pageItem P112_PERSONAL_ID (
        type: hidden
        layout {
            sequence: 140
            slot: contentBody
        }
    )

    pageItem P112_QUALIFICATIONS (
        type: displayOnly
        label {
            label: "&{QUALIFICATIONS_1}."
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 30
            region: @job-summary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: no-word-break
        }
        advanced {
            cssClasses: no-word-break
        }
    )

    pageItem P112_RESP (
        type: displayOnly
        label {
            label: "&{RESPONSIBILITIES_1}."
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 20
            region: @job-summary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: no-word-break
        }
        advanced {
            cssClasses: no-word-break
        }
    )

    pageItem P112_VACANCY_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    button clear (
        buttonName: Clear
        label: "&{CLEAR_CERTIFICATES}."
        layout {
            sequence: 110
            slot: contentBody
            startNewRow: false
            column: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    button complete-pers-info (
        buttonName: Complete_pers_info
        label: "&{COMPLETE_YOUR_PERSONAL_INFO_FIRST}."
        layout {
            sequence: 100
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 119
                action: clearRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsZero
            item: P112_COMPLETE_PI
        }
    )

    button submit (
        buttonName: Submit
        label: "&{APPLY_NOW}."
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 125
                items: {
                    P125_VACANCY_ID: &P112_VACANCY_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P112_DETAILS_FLG <> 1 and :P112_COMPLETE_PI <> 0
        }
    )

    validation c-date (
        name: C_Date
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P112_DATE_OF_ACQUISITION
        }
        error {
            errorMessage: "&{DATE_IS_REQUIRED}."
        }
        config {
            buildOption: @commented-out
        }
    )

    validation c-name (
        name: C_name
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P112_CERTIFICATE_NAME
        }
        error {
            errorMessage: "&{CERTIFICATE_NAME_IS_REQUIRED}."
        }
        config {
            buildOption: @commented-out
        }
    )

    validation resume (
        name: Resume
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P112_RESUME
        }
        error {
            errorMessage: "&{RESUME_IS_REQUIRED}."
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
        config {
            buildOption: @commented-out
        }
    )

    process check-job-vacancy (
        name: Check_job_vacancy
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P112_JOB_VACANCY_CHECK := Job_application_pkg.check_application_vacancy(:P112_PERSONAL_ID, :P112_VACANCY_ID);
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 345351913113189201
        }
    )

    process check-pi (
        name: Check_PI
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    :P112_COMPLETE_PI := Job_application_pkg.check_complete_personal_info(:APP_USER_ACC_ID);
                 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 352047891237205006
        }
    )

    process check-vacancy-id (
        name: Check vacancy id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    if :P112_VACANCY_ID is null then
                        raise_application_error(-20101, 'choose the job');
                    end if; 
                end;
                 
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 344020639986055035
        }
    )

    process clear-certificates (
        name: Clear Certificates
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                
                    apex_collection.delete_collection('CERTIFICATES');
                
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 344020454406055033
        }
        serverSideCondition {
            whenButtonPressed: @clear
        }
    )

    process get-vacancy-details (
        name: get_vacancy_details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                
                    select jv.title, jv.summary, jv.RESPONSIBILITIES, jv.QUALIFICATIONS, eduL.name as education_level 
                    into :P112_JOB_TITLE ,:P112_JOB_SUMMARY
                    , :P112_RESP, :P112_QUALIFICATIONS, :P112_EDUCATION_LEVEL from JOB_VACANCY jv
                    join education_level eduL on eduL.id = jv.MINIMUM_EDUCATION_LEVEL_ID
                    where jv.id = :P112_VACANCY_ID;
                 
                
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 329547604312456846
        }
    )

    process set-personal-id (
        name: set personal id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :APP_USER_PERS_ID is not null then
                        :P112_PERSONAL_ID := :APP_USER_PERS_ID;
                    else
                        raise_application_error(-20100, 'please complete your personal information');
                    end if;
                
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 344017451399055003
        }
    )

    process submit-process (
        name: Submit Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                    v_app_id number;
                
                begin
                
                    -- insert the job_application items 
                    v_app_id := Job_application_pkg.Save_Job_application(:P112_RESUME, :APP_USER_ACC_ID);
                
                
                    -- insert certificates
                    IF APEX_COLLECTION.COLLECTION_EXISTS('CERTIFICATES') THEN
                        FOR rec IN (
                            SELECT
                                c001,
                                d001
                            FROM apex_collections
                            WHERE collection_name = 'CERTIFICATES'
                        )
                        LOOP
                
                            Job_application_pkg.Save_other_certificates(v_app_id,
                                rec.c001,
                                rec.d001);
                
                        END LOOP;
                        apex_collection.delete_collection('CERTIFICATES');
                    END IF;
                    --insert into job_vacancy_application
                    Job_application_pkg.Save_Vacancy_application(v_app_id, :P112_VACANCY_ID);
                
                    
                
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 344019608682055025
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
        config {
            buildOption: @commented-out
        }
    )

)
