    dynamicAction select-country-phone-code (
        name: select country phone code
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P130_COUNTRY_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P130_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select country.phone_code from country country where id = :P130_COUNTRY_ID;
                itemsToSubmit: P130_COUNTRY_ID
            }
            affectedElements {
                selectionType: items
                items: P130_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 10
            }
        )

    )

