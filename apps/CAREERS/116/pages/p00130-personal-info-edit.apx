                --     FROM account
                --     WHERE id = :APP_USER_ACC_ID;
                -- END;
                
                
                BEGIN
                    IF :APP_USER_ACC_ID IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20001, 'User session expired. Please login again.');
                    END IF;
                    SELECT ID,
                           first_name,
                           second_name,
                           last_name,
                           date_of_birth,
                           gender,
                           email,
                           home_telephone,
                           address,
                           city_id,
                           national_id,
                           passport_number,
                           country_id,
                           country_phone_code_id,
                           mobile_telephone
                     INTO   :P130_ID,
                           :P130_FIRST_NAME,
                           :P130_SECOND_NAME,
                           :P130_LAST_NAME,
                           :P130_DATE_OF_BIRTH,
                           :P130_GENDER,
                           :P130_EMAIL,
                           :P130_HOME_TELEPHONE,
                           :P130_ADDRESS,
                           :P130_CITY_ID,
                           :P130_NATIONAL_ID,
                           :P130_PASSPORT_NUMBER,
                           :P130_COUNTRY_ID,
                           :P130_COUNTRY_PHONE_CODE_ID,
                           :P130_MOBILE_TELEPHONE
                    FROM account
                    WHERE id = :APP_USER_ACC_ID;
                END;
