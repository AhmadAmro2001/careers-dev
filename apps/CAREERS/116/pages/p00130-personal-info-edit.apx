page 130 (
    name: Personal Info Edit
    alias: PERSONAL-INFO-EDIT
    title: "&{PERSONAL_INFO_EDIT}."
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* ========================================================== */
            /* 1. STANDARD FORM FIELDS (TEXT, TEL, EMAIL, SELECT, ETC.)    */
            /* ========================================================== */
            
            .t-Form-fieldContainer input[type="text"],
            .t-Form-fieldContainer input[type="tel"],
            .t-Form-fieldContainer input[type="email"],
            .t-Form-fieldContainer input[type="date"],
            .t-Form-fieldContainer textarea,
            .t-Form-fieldContainer select.selectlist,
            .apex-item-text,
            .apex-item-textarea,
            .apex-item-select {
                background-color: rgb(232, 244, 255) !important; /* Light blue color */
                border-radius: 10px !important; /* Consistent 10px roundness */
                border: 1px solid #cbd5e1 !important;
                transition: all 0.3s ease !important;
            }
            
            
            
            /* Hover Effect for Standard Fields */
            .t-Form-fieldContainer input[type="text"]:hover,
            .t-Form-fieldContainer input[type="tel"]:hover,
            .t-Form-fieldContainer input[type="email"]:hover,
            .t-Form-fieldContainer input[type="date"]:hover,
            .t-Form-fieldContainer textarea:hover,
            .t-Form-fieldContainer select.selectlist:hover,
            .apex-item-text:hover,
            .apex-item-textarea:hover,
            .apex-item-select:hover {
                border-color: #0563bb !important;
                background-color: #f8fafc !important; 
            }
            
            /* Focus Effect */
            .apex-item-text:focus,
            .apex-item-textarea:focus,
            .apex-item-select:focus {
                border-color: #024486 !important;
                box-shadow: 0 0 0 3px rgba(5, 99, 187, 0.15) !important;
                outline: none !important;
            }
            
            /* File Upload Button */
            .apex-item-file {
                border-radius: 10px !important;
                transition: all 0.3s ease !important;
            }
            .apex-item-file:hover {
                border-color: #0563bb !important;
                background-color: #f8fafc !important;
            }
            
            
            /* ========================================================== */
            /* 2. DATE PICKER UNIFICATION (INPUT + CALENDAR ICON)          */
            /* ========================================================== */
            
            /* Lock input text container and icon button together tightly without affecting the label */
            .apex-item-group--datepicker,
            .apex-item-group.apex-item-group--file {
                display: inline-flex !important;
                width: 100% !important;
                align-items: stretch !important;
                gap: 0 !important;
            }
            
            /* Left side of the date component (Text Field) */
            .apex-item-group--datepicker input.apex-item-text,
            input.apex-item-datepicker {
                background-color: rgb(232, 244, 255) !important;
                border-top-left-radius: 10px !important;
                border-bottom-left-radius: 10px !important;
                border-top-right-radius: 0px !important;
                border-bottom-right-radius: 0px !important;
                border-right: none !important; 
            }
            
            /* Right side of the date component (Calendar Button) */
            .apex-item-group--datepicker .a-Button--calendar,
            .apex-item-group--datepicker .apex-item-datepicker-btn,
            .a-Button--calendar {
                border-top-left-radius: 0px !important;
                border-bottom-left-radius: 0px !important;
                border-top-right-radius: 10px !important; /* Perfectly matches the 10px layout roundness */
                border-bottom-right-radius: 10px !important;
                border: 1px solid #cbd5e1 !important;
                border-left: 1px solid #cbd5e1 !important; 
                background-color: #ffffff !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                box-shadow: none !important;
            }
            
            /* Grouped Hover Actions for Date Picker */
            .apex-item-group--datepicker:hover input,
            .apex-item-group--datepicker:hover .a-Button--calendar {
                border-color: #0563bb !important;
            }
            
            .apex-item-group--datepicker:hover input {
                background-color: #f8fafc !important;
            }
            
            /* Grouped Focus Actions for Date Picker */
            .apex-item-group--datepicker input:focus,
            .apex-item-group--datepicker input:focus + button {
                border-color: #024486 !important;
            }
            
            .t-Form-fieldContainer input[type="date"],
            .apex-item-text.apex-item-datepicker {
                border-radius: 10px 0 0 10px !important;
            }
            
            /* Calendar Button */
            .a-Button.a-Button--calendar,
            .ui-datepicker-trigger {
                border-radius: 0 10px 10px 0 !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region personal-info (
        name: Personal Info
        title: "&{PERSONAL_INFO}."
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select acc.ID,
                       acc.FIRST_NAME,
                       acc.LAST_NAME,
                       acc.DATE_OF_BIRTH,
                       acc.GENDER,
                       acc.EMAIL,
                       acc.HOME_TELEPHONE,
                       acc.ADDRESS,
                       acc.CITY_ID,
                       acc.NATIONAL_ID,
                       acc.SECOND_NAME,
                       acc.PASSPORT_NUMBER,
                       acc.COUNTRY_ID,
                       acc.COUNTRY_PHONE_CODE_ID,
                       acc.mobile_telephone,
                       pi.MARITAL_STATUS,
                       pi.military_status,
                       pi.mother_full_name,
                       pi.NATIONAL_ID_FILE_ID as national_id_image,
                       pi.id as pers_id_1
                  from ACCOUNT acc
                  join personal_info pi on pi.account_id = acc.id
                  JOIN CITIES c ON c.id = acc.city_id
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region personal-info-data (
        name: Personal Info Data
        title: "&{COMPLETE_YOUR_PERSONAL_INFO}."
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID As Pers_id,
                       ACCOUNT_ID,
                       NATIONAL_ID_IMAGE,
                       MOTHER_FULL_NAME,
                       MARITAL_STATUS,
                       MILITARY_STATUS,
                       PASSORT_NUMBER,
                       NAT_ID_FILE_NAME
                  from PERSONAL_INFO
                ```
        }
        layout {
            sequence: 40
            parentRegion: @personal-info-w
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region personal-info-w (
        name: Personal Info W
        title: "&{PERSONAL_INFO_W}."
