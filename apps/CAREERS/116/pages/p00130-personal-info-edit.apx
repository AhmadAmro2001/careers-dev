    dynamicAction pass-natid (
        name: pass_natId
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P130_COUNTRY_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P130_COUNTRY_ID').trim() === '' || $v('P130_COUNTRY_ID').trim() === '63';
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P130_NATIONAL_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
