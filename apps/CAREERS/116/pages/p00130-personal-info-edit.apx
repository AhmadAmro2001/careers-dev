    process get-user-pers-data-if-exists (
        name: get user pers data if exists
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                select p.id,p.id,p.mother_full_name, p.MILITARY_STATUS, p.MARITAL_STATUS 
                into 
                :APP_USER_PERS_ID ,:P130_Pers_id_1 ,:P130_MOTHER_FULL_NAME_1, :P130_MILITARY_STATUS_1, :P130_MARITAL_STATUS_1 
                from personal_info p 
                join MILITARY_STATUS mls on p.MILITARY_STATUS = mls.id 
                join MARITAL_STATUS ms on p.MARITAL_STATUS = ms.id
                where p.account_id = :APP_USER_ACC_ID;
                
                
                exception
                    when no_data_found then
                        :P130_MOTHER_FULL_NAME_1 := null;
                        :P130_MILITARY_STATUS_1  := null;
                        :P130_MARITAL_STATUS_1   := null;
                        :P130_PERS_ID_1 := null;
                
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17917357191055616
        }
    )

