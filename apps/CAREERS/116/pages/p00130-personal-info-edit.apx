    button cancel (
        buttonName: CANCEL
        label: "&{CANCEL}."
        layout {
            sequence: 20
            region: @personal-info
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    button next (
        buttonName: NEXT
        label: "&{NEXT}."
        layout {
            sequence: 10
            region: @personal-info-w
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    button next-pers (
        buttonName: NEXT_pers
        label: "&{SAVE}."
        layout {
            sequence: 30
            region: @personal-info
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P130_PERS_ID_1
        }
    )

    button save-pers (
        buttonName: Save_pers
        label: "&{UPDATE}."
        layout {
            sequence: 10
            region: @personal-info
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-chevron-right
