    pageItem P204_ROW (
        type: numberField
        label {
            label: "&{ROW}."
            alignment: left
        }
        layout {
            sequence: 10
            region: @vacancies
            slot: sortOrder
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button create (
        buttonName: CREATE
        label: "&{CREATE}."
        layout {
            sequence: 10
            region: @vacancies
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: show-app-btn
            icon: fa-plus-square
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 205
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: Submit
        label: "&{SUBMIT}."
        layout {
            sequence: 20
            region: @vacancies
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: more-details-btn
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .js-toggle-vacancy-archive
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // let vacancyID = $(this.triggeringElement).data("id");
                    
                    // console.log("vacancy id",vacancyID )
                    
                    // apex.server.process(
                    //     "VACANCY_ARCHIVE",
                    //     {
                    //         x01: vacancyID
                    //     },
                    //     {
                    //         success: function (data) {
                                
                    //             if(data.msg =='success'){
                    //             location.reload();
                                
                    //             }else{
                    //                 alert(data.err);
                    //             }
                    //         },
                    //         error: function (jqXHR, textStatus, errorThrown) {
                    //             console.log("Ajax error:", textStatus, errorThrown);
                    //         }
                    //     }
                    // );
                    
                    var btn = this.triggeringElement;
                    var vacancyId = btn.dataset.id;
                    var action = btn.dataset.vacancyAction;
                    
                    apex.server.process(
                        "TOGGLE_VACANCY_ARCHIVE",
                        {
                            x01: vacancyId,
                            x02: action
                        },
                        {
                            dataType: "json",
                            success: function (data) {
                                if (data.success) {
                                    apex.message.showPageSuccess(data.message);
                                    apex.region("vacancy_report").refresh();
                                    apex.region("facet_filter").refresh();
                                } else {
                                    apex.message.showErrors([
                                        {
                                            type: "error",
                                            location: "page",
                                            message: data.message,
                                            unsafe: false
                                        }
                                    ]);
                                }
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                                apex.message.showErrors([
                                    {
                                        type: "error",
                                        location: "page",
                                        message: "Error while changing vacancy archive status: " + errorThrown,
                                        unsafe: false
                                    }
                                ]);
                            }
                        }
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: refresh
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @vacancies
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vacancies
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process vacancy-archive (
        name: TOGGLE_VACANCY_ARCHIVE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- declare
                    
                -- begin
                    
                
                --     PKG_ADMIN.archive_vacancy(
                --         p_vacancy_id => TO_NUMBER(apex_application.g_x01)
                --     );
                
                --     apex_json.open_object;
                --     apex_json.write('msg', 'success');
                --     apex_json.write('err', '');
                --     apex_json.close_object;
                -- exception
                --     when others then
                --     apex_json.open_object;
                --     apex_json.write('msg', 'failed');
                --     apex_json.write('err', sqlerrm);
                --     apex_json.close_object;
                -- end;
                
                declare
                    l_vacancy_id number;
                    l_action     varchar2(20);
                begin
                    l_vacancy_id := to_number(apex_application.g_x01);
                    l_action     := upper(apex_application.g_x02);
                
                    if l_action = 'ARCHIVE' then
                
                        -- Replace with your real archive procedure
                        PKG_ADMIN.archive_vacancy(
                            p_vacancy_id => l_vacancy_id
                        );
                
                        apex_json.open_object;
                        apex_json.write('success', true);
                        apex_json.write('message', APEX_LANG.GET_MESSAGE('VACANCY_ARCHIVED'));
                        apex_json.close_object;
                
                    elsif l_action = 'UNARCHIVE' then
                
                        -- Replace with your real unarchive procedure
                        PKG_ADMIN.unarchive_vacancy(
                            p_vacancy_id => l_vacancy_id
                        );
                
                        apex_json.open_object;
                        apex_json.write('success', true);
                        apex_json.write('message', APEX_LANG.GET_MESSAGE('VACANCY_UNARCHIVED'));
                        apex_json.close_object;
                
                    else
                        raise_application_error(-20001, APEX_LANG.GET_MESSAGE('INVALID_VACANCY_ARCHIVE_ACTION'));
                    end if;
                
                exception
                    when others then
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', sqlerrm);
                        apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 345232662620624610
        }
    )

)
