page 204 (
    name: Vacancies
    alias: VACANCIES
    title: "&{VACANCIES}."
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            
            
            ```
    }
    security {
        authorizationScheme: @admin-schema
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: "&{BREADCRUMB}."
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filter (
        name: Filter
        title: "&{FILTER}."
        type: facetedSearch
        source {
            filteredRegion: @vacancies
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 2
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: facet_filter
        }
        settings {
            compactNosThreshold: 10000
            displayChartForTopNValues: 10
        }

        facet P204_ARCHIVED (
            type: radioGroup
            label {
                label: "&{ARCHIVED}."
            }
            lov {
                type: staticValues
                staticValues: STATIC:Archived;Yes,Not Archived;No
            }
            layout {
                sequence: 20
            }
            listEntries {
                zeroCountEntries: disable
                sortByTopCounts: false
                maxDisplayedEntries: 7
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: IS_ARCHIVED
            }
            default {
                type: static
                staticValue: No
            }
        )

        facet P204_CATEGORY (
            type: checkboxGroup
            label {
                label: "&{CATEGORY}."
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select name , name as return_value
                    from career_category
                    ```
            }
            layout {
                sequence: 10
            }
            listEntries {
                zeroCountEntries: disable
                sortByTopCounts: false
                maxDisplayedEntries: 7
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: CATEGORY
            }
        )

        facet P204_VACANCY_TYPE (
            type: radioGroup
            label {
                label: "&{VACANCY_TYPE}."
            }
            lov {
                type: staticValues
                staticValues: STATIC:Public;0,EGPC Exclusive;1
            }
            layout {
                sequence: 30
            }
            listEntries {
                zeroCountEntries: disable
                sortByTopCounts: false
                maxDisplayedEntries: 7
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: IS_MINISTRY_EXCLUSIVE
                dataType: number
            }
        )

    )

    region vacancies (
        name: Vacancies
        title: "&{VACANCIES}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.ID,
                       
                       v.TITLE || ' ' || v.TITLE_CODE AS TITLE,
                       v.POST_DATE,
                       
                       c.NAME AS Category,
                       v.is_archived as archived_value,
                       CASE 
                           WHEN v.IS_ARCHIVED = 1 THEN 'Yes'
                           ELSE 'No'
                       END AS IS_ARCHIVED,
                       
                       COUNT(va.ID) AS TOTAL_APPLICATIONS,
                       'Applications' AS SHOW_APP,
                       'Details' AS VACANCY_DETAILS,
                       'Edit' AS VACANCY_EDIT,
                    --    'Archive' AS ARCHIVE_VACANCY,
                        case 
                            when nvl(v.IS_ARCHIVED, 0) = 1 then 'UNARCHIVE'
                            else 'ARCHIVE'
                        end as ARCHIVE_ACTION,
                
                        case 
                            when nvl(v.IS_ARCHIVED, 0) = 1 then 'Unarchive Vacancy'
                            else 'Archive Vacancy'
                        end as ARCHIVE_TITLE,
                
                        case 
                            when nvl(v.IS_ARCHIVED, 0) = 1 then 'fa-undo'
                            else 'fa-archive'
                        end as ARCHIVE_ICON,
                
                        case 
                            when nvl(v.IS_ARCHIVED, 0) = 1 then 'is-archived'
                            else 'is-active'
                        end as ARCHIVE_STATE_CLASS,
                
                        v.ID as ARCHIVE_DATA,
                
                        'Archive' as ARCHIVE_VACANCY,
                        v.IS_MINISTRY_EXCLUSIVE
                
                       
                    from JOB_VACANCY v
                    LEFT  join JOB_VACANCY_APPLICATION va
                    on v.ID = va.VACANCY_ID
                     join CAREER_CATEGORY c
                    on v.CATEGORY_ID = c.ID
                    -- where v.is_archived =
                    -- case
                    --     when :P204_ARCHIVED = 'Yes' then 1
                    --     else 0
                    -- end
                    GROUP BY v.ID,
                         v.TITLE,
                         v.TITLE_CODE,
                         v.POST_DATE,
                         v.IS_ARCHIVED,
                         c.NAME,
                         v.IS_MINISTRY_EXCLUSIVE
                    ;
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: vacancy_report
        }
        reportLayout {
            numberOfRowsType: itemValue
            item: P204_ROW
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }

        column ARCHIVED_VALUE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 180
            }
        )

        column ARCHIVE_ACTION (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 190
            }
        )

        column ARCHIVE_DATA (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column ARCHIVE_ICON (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column ARCHIVE_STATE_CLASS (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 200
            }
        )

        column ARCHIVE_TITLE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 130
            }
        )

        column ARCHIVE_VACANCY (
            reportColumnQueryId: 16
            derivedColumn: N
            heading {
                heading: "&{ARCHIVE_VACANCY}."
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <button type="button"
                            class="t-Button t-Button--small t-Button--icon js-toggle-vacancy-archive archive-btn #ARCHIVE_STATE_CLASS#"
                            title="#ARCHIVE_TITLE#"
                            data-id="#ARCHIVE_DATA#"
                            data-vacancy-action="#ARCHIVE_ACTION#">
                    
                        <span class="t-Icon fa #ARCHIVE_ICON#" aria-hidden="true"></span>
                    </button>
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column CATEGORY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: "&{CATEGORY}."
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column IS_ARCHIVED (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column IS_MINISTRY_EXCLUSIVE (
            reportColumnQueryId: 17
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column POST_DATE (
            reportColumnQueryId: 3
            derivedColumn: N
