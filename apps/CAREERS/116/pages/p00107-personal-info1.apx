page 107 (
    name: Personal Info
    alias: PERSONAL-INFO1
    title: "&{PERSONAL_INFO}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region personal-info (
        name: Personal Info
        title: "&{PERSONAL_INFO}."
        type: form
        source {
            location: localDatabase
            tableName: ACCOUNT
        }
        layout {
            sequence: 10
            slot: body
            column: 3
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P107_ADDRESS (
        type: textarea
        label {
            label: "&{ADDRESS}."
            alignment: left
        }
        layout {
            sequence: 120
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @personal-info
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P107_CITY (
        type: textField
        label {
            label: "&{CITY}."
            alignment: left
        }
        layout {
            sequence: 130
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @personal-info
            column: CITY
            dataType: varchar2
        }
    )

    pageItem P107_COUNTRY_ID (
        type: selectList
        label {
            label: "&{COUNTRY_1}."
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @country-name
        }
        layout {
            sequence: 280
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @personal-info
            column: COUNTRY_ID
            dataType: number
        }
    )

    pageItem P107_COUNTRY_PHONE_CODE_ID (
        type: textField
        label {
            label: "&{COUNTRY_PHONE_CODE}."
            alignment: left
        }
        layout {
            sequence: 290
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: readonly
        }
        source {
            formRegion: @personal-info
            column: COUNTRY_PHONE_CODE_ID
            dataType: number
        }
    )

    pageItem P107_DATE_OF_BIRTH (
        type: datePicker
        label {
            label: "&{DATE_OF_BIRTH}."
            alignment: left
        }
        layout {
            sequence: 70
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @personal-info
            column: DATE_OF_BIRTH
            dataType: date
        }
    )

    pageItem P107_EMAIL (
        type: textField
        label {
            label: "&{EMAIL}."
            alignment: left
        }
        layout {
            sequence: 90
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @personal-info
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P107_FIRST_NAME (
        type: textField
        label {
            label: "&{FIRST_NAME}."
            alignment: left
        }
        layout {
            sequence: 40
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @personal-info
            column: FIRST_NAME
            dataType: varchar2
        }
    )

    pageItem P107_GENDER (
        type: selectList
        label {
            label: "&{GENDER}."
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Male;Male,Female;Female
        }
        layout {
            sequence: 80
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @personal-info
            column: GENDER
            dataType: varchar2
        }
    )

    pageItem P107_HOME_TELEPHONE (
        type: textField
        label {
            label: "&{HOME_TELEPHONE}."
            alignment: left
        }
        layout {
            sequence: 110
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @personal-info
            column: HOME_TELEPHONE
            dataType: varchar2
        }
    )

    pageItem P107_ID (
        type: hidden
        layout {
            sequence: 10
            region: @personal-info
            slot: regionBody
        }
        source {
            formRegion: @personal-info
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P107_LAST_NAME (
        type: textField
        label {
            label: "&{LAST_NAME}."
            alignment: left
        }
        layout {
            sequence: 60
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @personal-info
            column: LAST_NAME
            dataType: varchar2
        }
    )

    pageItem P107_NATIONAL_ID (
        type: textField
        label {
            label: "&{NATIONAL_ID}."
            alignment: left
        }
        layout {
            sequence: 190
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 14
        }
        source {
            formRegion: @personal-info
            column: NATIONAL_ID
            dataType: varchar2
        }
    )

    pageItem P107_PASSPORT_NUMBER (
        type: textField
        label {
            label: "&{PASSPORT_NUMBER}."
            alignment: left
        }
        layout {
            sequence: 260
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @personal-info
            column: PASSPORT_NUMBER
            dataType: varchar2
        }
    )

    pageItem P107_SECOND_NAME (
        type: textField
        label {
            label: "&{SECOND_NAME}."
            alignment: left
        }
        layout {
            sequence: 50
            region: @personal-info
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @personal-info
            column: SECOND_NAME
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: "&{CANCEL}."
        layout {
            sequence: 10
            region: @personal-info
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: "&{SAVE}."
        layout {
            sequence: 40
            region: @personal-info
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P107_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: "&{DELETE}."
        layout {
            sequence: 20
            region: @personal-info
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P107_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: "&{APPLY_CHANGES}."
        layout {
            sequence: 30
            region: @personal-info
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P107_ID
        }
    )

    dynamicAction pass-natid (
        name: pass_natId
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P107_COUNTRY_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P107_COUNTRY_ID').trim() === '' || $v('P107_COUNTRY_ID').trim() === '63';
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P107_NATIONAL_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P107_NATIONAL_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction passport-or-natid (
        name: passport_or_natID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P107_COUNTRY_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P107_COUNTRY_ID').trim() !== '' && $v('P107_COUNTRY_ID').trim() !== '63'
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P107_PASSPORT_NUMBER
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P107_PASSPORT_NUMBER
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction select-country-phone-code (
        name: select country phone code
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P107_COUNTRY_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P107_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select country.phone_code from country country where id = :P107_COUNTRY_ID;
                itemsToSubmit: P107_COUNTRY_ID
            }
            affectedElements {
                selectionType: items
                items: P107_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    validation number-validation (
        name: number_validation
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNumeric
            item: P107_HOME_TELEPHONE
        }
        error {
            errorMessage: "&{PHONE_NUMBER_MUST_BE_NUMBERS_ONLY}."
            associatedItem: @P107_HOME_TELEPHONE
        }
    )

    process get-user-data-if-exist (
        name: get user data if exist
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :APP_USER_ACC_ID IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20001, 'User session expired. Please login again.');
                    END IF;
                    SELECT ID,
                           first_name,
                           second_name,
                           last_name,
                           date_of_birth,
                           gender,
                           email,
                           home_telephone,
                           address,
                           city,
                           national_id,
                           passport_number,
                           country_id,
                           country_phone_code_id
                    INTO   :P107_ID,
                           :P107_FIRST_NAME,
                           :P107_SECOND_NAME,
                           :P107_LAST_NAME,
                           :P107_DATE_OF_BIRTH,
                           :P107_GENDER,
                           :P107_EMAIL,
                           :P107_HOME_TELEPHONE,
                           :P107_ADDRESS,
                           :P107_CITY,
                           :P107_NATIONAL_ID,
                           :P107_PASSPORT_NUMBER,
                           :P107_COUNTRY_ID,
                           :P107_COUNTRY_PHONE_CODE_ID
                    FROM account
                    WHERE id = :APP_USER_ACC_ID;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 337359625649663850
        }
    )

    process initialize-form-personal-info (
        name: Initialize form Personal Info
        type: formInitialization
        formRegion: @personal-info
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 338363051048389377
        }
    )

    process process-form-personal-info (
        name: Process form Personal Info
        type: formAutoRowProcessing
        formRegion: @personal-info
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 338363476359389378
        }
        config {
            buildOption: @commented-out
        }
    )

    process update-account (
        name: Update account
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                
                
                    user_personal_info_pkg.Complete_account_data(:P107_FIRST_NAME, :P107_SECOND_NAME, :P107_LAST_NAME,
                    :P107_DATE_OF_BIRTH, :P107_GENDER, :P107_EMAIL, :P107_HOME_TELEPHONE, :P107_ADDRESS, :P107_CITY,
                    :P107_NATIONAL_ID, :P107_PASSPORT_NUMBER, :P107_COUNTRY_ID, :P107_COUNTRY_PHONE_CODE_ID, :APP_USER_ACC_ID);
                
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 337359571663663849
        }
    )

    branch (
        name: Go To P info data
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 108
            }
        }
    )

)
