page 201 (
    name: Reset Admin Password
    alias: RESET-ADMIN-PASSWORD
    title: "&{RESET_ADMIN_PASSWORD}."
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .t-Login-logo,
            .t-Login-logo .app-icon {
                background: transparent !important;
                box-shadow: none !important;
                border-radius: 0 !important;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region reset-password (
        name: Reset Password
        title: "&{RESET_PASSWORD}."
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#career_logo-removebg-preview.png
        }
    )

    pageItem P201_CONFIRM_PASSWORD (
        type: password
        label {
            label: "&{CONFIRM_PASSWORD}."
            alignment: left
        }
        layout {
            sequence: 40
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P201_ID (
        type: hidden
        layout {
            sequence: 10
            region: @reset-password
            slot: regionBody
        }
    )

    pageItem P201_PASSWORD (
        type: password
        label {
            label: "&{PASSWORD}."
            alignment: left
        }
        layout {
            sequence: 30
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P201_USERNAME (
        type: textField
        label {
            label: "&{USERNAME}."
            alignment: left
        }
        layout {
            sequence: 20
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button submit (
        buttonName: Submit
        label: "&{SUBMIT}."
        layout {
            sequence: 30
            region: @reset-password
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation compare-password (
        name: compare password
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression:
                ```plsql
                -- DECLARE
                
                
                --     e_no_match EXCEPTION;
                -- BEGIN
                --     if :P201_PASSWORD <> :P201_CONFIRM_PASSWORD then
                --         RAISE e_no_match;
                --     END IF ;
                
                -- EXCEPTION
                --     WHEN e_no_match THEN
                --         RAISE_APPLICATION_ERROR(-20001,'please match the passwords');
                -- END;
                
                :P201_PASSWORD = :P201_CONFIRM_PASSWORD
                ```
        }
        error {
            errorMessage: "&{PLEASE_MATCH_BOTH_PASSWORDS}."
            associatedItem: @P201_CONFIRM_PASSWORD
        }
    )

    process reset-pass (
        name: RESET PASS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                
                begin
                    PKG_ADMIN.reset_admin_password(
                        p_username     => :P201_USERNAME,
                        p_new_password => :P201_PASSWORD
                    );
                
                    COMMIT;
                    
                    -- :APP_ADMIN_ACC_USERNAME := :P201_USERNAME ;
                
                    APEX_UTIL.REDIRECT_URL(
                            'f?p=' || :APP_ID || ':9999:' || :APP_SESSION 
                        );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 337341893442636724
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)
