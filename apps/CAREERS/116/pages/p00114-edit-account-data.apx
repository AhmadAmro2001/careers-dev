page 114 (
    name: Edit Account Data
    alias: EDIT-ACCOUNT-DATA
    title: "&{EDIT_ACCOUNT_DATA}."
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        title: "&{BUTTONS}."
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region edit-account-data (
        name: Edit Account Data
        title: "&{EDIT_ACCOUNT_DATA}."
        type: form
        source {
            location: localDatabase
            tableName: ACCOUNT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P114_ADDRESS (
        type: textarea
        label {
            label: "&{ADDRESS}."
            alignment: left
        }
        layout {
            sequence: 130
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @edit-account-data
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P114_CITY (
        type: textField
        label {
            label: "&{CITY}."
            alignment: left
        }
        layout {
            sequence: 140
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @edit-account-data
            column: CITY
            dataType: varchar2
        }
    )

    pageItem P114_COUNTRY_ID (
        type: selectList
        label {
            label: "&{COUNTRY}."
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @country-name
        }
        layout {
            sequence: 170
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @edit-account-data
            column: COUNTRY_ID
            dataType: number
        }
    )

    pageItem P114_COUNTRY_PHONE_CODE_ID (
        type: textField
        label {
            label: "&{COUNTRY_PHONE_CODE_1}."
            alignment: left
        }
        layout {
            sequence: 180
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: readonly
        }
        source {
            formRegion: @edit-account-data
            column: COUNTRY_PHONE_CODE_ID
            dataType: number
        }
    )

    pageItem P114_DATE_OF_BIRTH (
