            alignment: left
        }
        layout {
            sequence: 80
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @edit-account-data
            column: GENDER
            dataType: varchar2
        }
    )

    pageItem P114_HOME_TELEPHONE (
        type: textField
        label {
            label: "&{HOME_TELEPHONE}."
            alignment: left
        }
        layout {
            sequence: 120
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @edit-account-data
            column: HOME_TELEPHONE
            dataType: varchar2
        }
    )

    pageItem P114_ID (
        type: hidden
        layout {
            sequence: 10
            region: @edit-account-data
            slot: regionBody
        }
        source {
            formRegion: @edit-account-data
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P114_LAST_NAME (
        type: textField
        label {
            label: "&{LAST_NAME}."
            alignment: left
        }
        layout {
            sequence: 60
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
