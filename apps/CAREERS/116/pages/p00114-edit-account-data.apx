        }
    )

    pageItem P114_SECOND_NAME (
        type: textField
        label {
            label: "&{SECOND_NAME}."
            alignment: left
        }
        layout {
            sequence: 50
            region: @edit-account-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
