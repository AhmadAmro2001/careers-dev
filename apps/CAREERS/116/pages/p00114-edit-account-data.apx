    button cancel (
        buttonName: CANCEL
        label: "&{CANCEL}."
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: "&{CREATE}."
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P114_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: "&{DELETE}."
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P114_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: "&{APPLY_CHANGES}."
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P114_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass-natid (
        name: pass_natId
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P114_COUNTRY_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P114_COUNTRY_ID').trim() === '' || $v('P114_COUNTRY_ID').trim() === '63';
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P114_NATIONAL_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P114_NATIONAL_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction passport-or-natid (
        name: passport_or_natID
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P114_COUNTRY_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P114_COUNTRY_ID').trim() !== '' && $v('P114_COUNTRY_ID').trim() !== '63'
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P114_PASSPORT_NUMBER
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P114_PASSPORT_NUMBER
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction select-country-phone-code (
        name: select country phone code
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P114_COUNTRY_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P114_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select country.phone_code from country country where id = :P114_COUNTRY_ID;
                itemsToSubmit: P114_COUNTRY_ID
            }
            affectedElements {
                selectionType: items
                items: P114_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 349766365129374272
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-edit-account-data (
        name: Initialize form Edit Account Data
        type: formInitialization
        formRegion: @edit-account-data
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 349765523319374271
        }
    )

    process process-form-edit-account-data (
        name: Process form Edit Account Data
        type: formAutoRowProcessing
        formRegion: @edit-account-data
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 349765978296374271
        }
    )

)
