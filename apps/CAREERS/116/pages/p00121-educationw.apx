page 121 (
    name: Education
    alias: EDUCATIONW
    title: "&{EDUCATION}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* Region Container */
            #modern_report {
                background: #f8fafc;
                border-radius: 18px;
                padding: 18px;
                box-shadow: 0 4px 14px rgba(0,0,0,0.08);
                border: none;
            }
            
            /* Report Table */
            #modern_report .t-Report-report {
                border-collapse: separate;
                border-spacing: 0 10px;
                width: 100%;
            }
            
            /* Header */
            #modern_report .t-Report-colHead {
                background: #001b47;
                color: white;
                font-size: 14px;
                font-weight: 600;
                padding: 14px;
                border: none;
            }
            
            /* Header First/Last Radius */
            #modern_report .t-Report-colHead:first-child {
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }
            
            #modern_report .t-Report-colHead:last-child {
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }
            
            /* Rows */
            #modern_report .t-Report-report tbody tr {
                background: white;
                transition: 0.3s;
                box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            }
            
            /* Rows Links */
            #modern_report .t-Report-report tbody tr a{
                color: rgb(0, 48, 65);
                text-decoration: none;
                font-weight: 600;
            }
            
            #modern_report .t-Report-report tbody tr a:hover{
                color: rgb(0, 119, 255);
            }
            
            /* Hover Effect */
            #modern_report .t-Report-report tbody tr:hover {
                transform: scale(1.01);
                background: #f1f5f9;
            }
            
            /* Cells */
            #modern_report .t-Report-cell {
                padding: 16px;
                border: none;
                font-size: 14px;
                color: #334155;
            }
            
            /* First Cell Radius */
            #modern_report .t-Report-cell:first-child {
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }
            
            /* Last Cell Radius */
            #modern_report .t-Report-cell:last-child {
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }
            
            /* Pagination */
            #modern_report .t-Report-pagination {
                margin-top: 15px;
                text-align: center;
            }
            
            /* Links */
            #modern_report a {
                color: rgb(169, 234, 255);
                text-decoration: none;
                font-weight: 600;
            }
            
            #modern_report a:hover {
                color: #9db7ff;
            }
            
            #modern_report,
            #modern_report .t-Region-body,
            #modern_report .t-Report,
            #modern_report .t-Report-wrap,
            #modern_report .t-Report-tableWrap {
                border: none !important;
                box-shadow: none !important;
                background: transparent !important;
            }
            
            /* Remove table borders */
            #modern_report table,
            #modern_report th,
            #modern_report td {
                border: none !important;
            }
            
            /* Remove outer gray line */
            #modern_report .t-Report-report {
                border: none !important;
                outline: none !important;
            }
            
            
            
            /* ========================================================== */
            /* 1. STANDARD FORM FIELDS (TEXT, TEL, EMAIL, SELECT, ETC.)    */
            /* ========================================================== */
            
            
            
            .t-Form-fieldContainer input[type="text"],
            .t-Form-fieldContainer input[type="tel"],
            .t-Form-fieldContainer input[type="email"],
            .t-Form-fieldContainer input[type="date"],
            .t-Form-fieldContainer textarea,
            .apex-item-text,
            .apex-item-textarea {
                background-color: rgb(232, 244, 255)  !important; 
                border-radius: 10px !important; /* Consistent 10px roundness */
                border: 1px solid rgba(232, 244, 255, 0.705) !important;
                transition: all 0.3s ease !important;
            }
            
            .t-Form-fieldContainer select,
            .apex-item-select {
                background-color: rgb(232, 244, 255)  !important; 
                border-radius: 10px !important;
            }
            
            .t-Form-label::before{
                background-color: rgb(232, 244, 255)  !important; 
                border: none;
                background: transparent;
            }
            
            .t-Form-label:hover::before {
                background-color: rgb(232, 244, 255)  !important; 
            }
            
            .apex-item-file {
                border-radius: 10px !important;
                transition: all 0.3s ease !important;
            }
            .apex-item-file:hover {
                border-color: #0563bb !important;
                background-color: #f8fafc !important;
            }
            
            .apex-item-group--datepicker,
            .apex-item-group.apex-item-group--file {
                display: inline-flex !important;
                width: 100% !important;
                align-items: stretch !important;
                gap: 0 !important;
            }
            
            /* Left side of the date component (Text Field) */
            .apex-item-group--datepicker input.apex-item-text,
            input.apex-item-datepicker {
                background-color: rgb(232, 244, 255)  !important; 
                border-top-left-radius: 10px !important;
                border-bottom-left-radius: 10px !important;
                border-top-right-radius: 0px !important;
                border-bottom-right-radius: 0px !important;
                border-right: none !important; 
            }
            
            /* Right side of the date component (Calendar Button) */
            .apex-item-group--datepicker .a-Button--calendar,
            .apex-item-group--datepicker .apex-item-datepicker-btn,
            .a-Button--calendar {
                border-top-left-radius: 0px !important;
                border-bottom-left-radius: 0px !important;
                border-top-right-radius: 10px !important; /* Perfectly matches the 10px layout roundness */
                border-bottom-right-radius: 10px !important;
                border: 1px solid #cbd5e1 !important;
                border-left: 1px solid #cbd5e1 !important; 
                background-color: rgb(232, 244, 255)  !important; 
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                box-shadow: none !important;
            }
            /* ========================================================== */
            /* CUSTOM NAVBAR                                               */
            /* ========================================================== */
            
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            
                background: rgb(233, 233, 233);
            
                padding: 14px 24px;
            
                border-radius: 18px;
            
                box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            
                margin-bottom: 20px;
            }
            
            /* Left Links */
            .nav-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            
            /* Nav Links */
            .nav-link {
                display: flex;
                align-items: center;
                gap: 8px;
            
                text-decoration: none;
            
                color: #334155;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Hover */
            .nav-link:hover {
                background: rgb(232, 244, 255);
                color: #0563bb;
            }
            
            /* Logout Button */
            .logout-btn {
                display: flex;
                align-items: center;
                gap: 8px;
            
                background: #ef4444;
            
                color: white !important;
            
                text-decoration: none;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Logout Hover */
            .logout-btn:hover {
                background: #dc2626;
                transform: translateY(-1px);
            }
            
            /* Icons */
            .custom-navbar .fa {
                font-size: 14px;
            }
            
            
            /* [data-header="National Id Image"] img,
            [data-header="NATIONAL_ID_IMAGE"] img {
                width: 300px !important;
                height: auto !important;
            } */
            
            
            /* img {
                width: 250px !important;
                height: 130px !important;
                object-fit: cover;
                border-radius: 10px;
            } */
            
            .nav-right {
                display: flex;
                align-items: center;
                gap: 15px;
            }
            
            .user-name {
                color: #333;
                font-weight: 600;
            }
            
            /* Make navbar wrap on small screens */
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap; /* مهم جداً */
            }
            
            /* Mobile & small tablets */
            @media (max-width: 768px) {
                .custom-navbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 12px;
                }
            
                .nav-left,
                .nav-right {
                    width: 100%;
                    justify-content: flex-start;
                    flex-wrap: wrap;
                }
            
                .nav-link,
                .logout-btn {
                    width: 100%;
                    justify-content: center;
                }
            
                .user-name {
                    width: 100%;
                    text-align: left;
                }
            }
            
            /* Very small screens (phones) */
            @media (max-width: 480px) {
                .nav-link,
                .logout-btn {
                    padding: 12px;
                    font-size: 14px;
                }
            
                .custom-navbar {
                    padding: 12px;
                }
            }
            
            /* ==========================================================
               EDUCATION REPORT - MOBILE CARD VIEW
               ========================================================== */
            
            @media (max-width: 768px) {
            
                /* Report container */
                #modern_report {
                    width: 100% !important;
                    max-width: 100% !important;
                    box-sizing: border-box !important;
                    padding: 10px !important;
                    overflow: visible !important;
                }
            
                /* Remove normal table spacing */
                #modern_report .t-Report-report {
                    width: 100% !important;
                    max-width: 100% !important;
                    border-spacing: 0 !important;
                    display: block !important;
                }
            
                /* Hide table header */
                #modern_report .t-Report-report thead {
                    display: none !important;
                }
            
                /* Table body */
                #modern_report .t-Report-report tbody {
                    display: block !important;
                    width: 100% !important;
                }
            
                /* ======================================================
                   EACH DATABASE RECORD = ONE CARD
                   ====================================================== */
            
                #modern_report .t-Report-report tbody tr {
                    display: block !important;
            
                    width: 100% !important;
                    max-width: 100% !important;
            
                    margin: 0 0 15px 0 !important;
                    padding: 8px !important;
            
                    box-sizing: border-box !important;
            
                    background: #ffffff !important;
            
                    border-radius: 12px !important;
            
                    box-shadow: 0 2px 8px rgba(0,0,0,0.08) !important;
            
                    transform: none !important;
                }
            
                /* ======================================================
                   EACH COLUMN = KEY / VALUE ROW
                   ====================================================== */
            
                #modern_report .t-Report-report tbody td {
            
                    display: grid !important;
            
                    grid-template-columns: 45% 55% !important;
            
                    width: 100% !important;
            
                    min-width: 0 !important;
            
                    box-sizing: border-box !important;
            
                    padding: 10px 6px !important;
            
                    border-bottom: 1px solid #e5e7eb !important;
            
                    font-size: 13px !important;
            
                    line-height: 1.4 !important;
            
                    color: #334155 !important;
            
                    overflow-wrap: anywhere !important;
            
                    word-break: break-word !important;
            
                    text-align: left !important;
            
                    align-items: center !important;
                }
            
                /* Last row doesn't need separator */
                #modern_report .t-Report-report tbody td:last-child {
                    border-bottom: none !important;
                }
            
            
                /* ======================================================
                   COLUMN LABELS
                   ====================================================== */
            
                /* Graduation Year */
                #modern_report .t-Report-report tbody td:nth-child(1)::before {
                    content: "Graduation Year";
                    font-weight: 600 !important;
                    color: #001b47 !important;
                    padding-right: 8px !important;
                }
            
                /* University */
                #modern_report .t-Report-report tbody td:nth-child(2)::before {
                    content: "University";
                    font-weight: 600 !important;
                    color: #001b47 !important;
                    padding-right: 8px !important;
                }
            
                /* Degree */
                #modern_report .t-Report-report tbody td:nth-child(3)::before {
                    content: "Degree";
                    font-weight: 600 !important;
                    color: #001b47 !important;
                    padding-right: 8px !important;
                }
            
                /* Major */
                #modern_report .t-Report-report tbody td:nth-child(4)::before {
                    content: "Major";
                    font-weight: 600 !important;
                    color: #001b47 !important;
                    padding-right: 8px !important;
                }
            
                /* Grade */
                #modern_report .t-Report-report tbody td:nth-child(5)::before {
                    content: "Grade";
                    font-weight: 600 !important;
                    color: #001b47 !important;
                    padding-right: 8px !important;
                }
            
                /* Download */
                #modern_report .t-Report-report tbody td:nth-child(6)::before {
                    content: "Download";
                    font-weight: 600 !important;
                    color: #001b47 !important;
                    padding-right: 8px !important;
                }
            
            
                /* ======================================================
                   LINKS
                   ====================================================== */
            
                #modern_report .t-Report-report tbody td a {
                    color: #003041 !important;
                    font-weight: 600 !important;
                    text-decoration: none !important;
                }
            
            
                /* ======================================================
                   IMAGES
                   ====================================================== */
            
                #modern_report .t-Report-report tbody td img {
                    max-width: 100% !important;
                    width: 100px !important;
                    height: auto !important;
                    object-fit: contain !important;
                    border-radius: 8px !important;
                }
            
            
                /* ======================================================
                   REMOVE DESKTOP HOVER EFFECT ON MOBILE
                   ====================================================== */
            
                #modern_report .t-Report-report tbody tr:hover {
                    transform: none !important;
                }
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region education (
        name: Education
        title: "&{EDUCATION}."
        type: form
