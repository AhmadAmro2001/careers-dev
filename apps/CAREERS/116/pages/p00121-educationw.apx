    validation not-greater-than-today (
        name: not greater than today
        execution {
            sequence: 80
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_year NUMBER := EXTRACT(YEAR FROM SYSDATE);
                BEGIN
                    RETURN :P121_GRADUATION_YEAR <= v_year;
                END;
                ```
        }
        error {
            errorMessage: "&{THIS_IS_INVALID_YEAR}."
            associatedItem: @P121_GRADUATION_YEAR
        }
    )

