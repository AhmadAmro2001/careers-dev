    process save-and-add (
        name: save and add
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    user_personal_info_pkg.save_education_degree(:P121_EDUCATION_LEVEL, :P121_EDUCATION_FIELD,
                    :P121_GRADUATION_YEAR, :P121_EDUCATION_GRADE, :P121_UNIVERSITY, :P121_OTHER_EDUCATION_FIELD,
                    :APP_USER_PERS_ID, :P121_GRADUATION_CERTIFICATE);
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: "&{THE_EDUCATION_ADDED}."
        }
        advanced {
            executionMappingIdentifier: 350839902378514775
        }
        serverSideCondition {
            whenButtonPressed: @next-2
        }
    )

    process save-and-add-2 (
        name: save and add_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                
                    insert into JOB_APPLICATION_LANGUAGE(LANGUAGE_ID, LANGUAGE_LEVEL_ID, PERSONAL_ID)
                    values(:P121_LANGUAGE_ID, :P121_LANGUAGE_LEVEL_ID, :APP_USER_PERS_ID);
                
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: "&{LANGUAGE_ADDED}."
        }
        advanced {
            executionMappingIdentifier: 352051948146205047
        }
        serverSideCondition {
            whenButtonPressed: @langsave
        }
    )

