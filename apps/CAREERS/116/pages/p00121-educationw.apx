    process check-edu-person (
        name: Check_EDU_Person
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    SELECT 1
                    INTO :P121_EDUCARION_CHECK
                    FROM education_degree
                    WHERE personal_id = :APP_USER_PERS_ID
                    FETCH FIRST 1 ROW ONLY;
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        :P121_EDUCARION_CHECK := 0;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 350836844598505948
        }
    )

    process check-lang (
        name: Check_lang
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    SELECT count(*)
                    INTO :P121_LANG_CHECK
                    FROM JOB_APPLICATION_LANGUAGE
                    WHERE personal_id = :APP_USER_PERS_ID;
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        :P121_LANG_CHECK := NULL;
                END;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 352456316023679499
        }
    )

    process logout-process (
        name: logout Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    APEX_UTIL.SET_SESSION_STATE('APP_USER_ACC_ID', NULL);
                    APEX_UTIL.SET_SESSION_STATE('APP_USER_PERS_ID', NULL);
                    -- apex_authentication.logout;
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 22279767641130180
        }
        serverSideCondition {
            type: request=Value
            value: LOGOUT
        }
    )

