    region personal-lang (
        name: personal_Lang
        title: "&{PERSONALLANG}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select app_lang.ID,
                       lang.name as language,
                       lang_lev.name as language_Level
                  from JOB_APPLICATION_LANGUAGE app_lang
                  join LANGUAGE lang on lang.id = app_lang.LANGUAGE_ID
                  join LANGUAGE_LEVEL lang_lev on lang_lev.id = app_lang.LANGUAGE_LEVEL_ID
                  Where Personal_id = :APP_USER_PERS_ID;
                ```
        }
        layout {
            sequence: 50
            parentRegion: @educationw
            slot: wizardSubRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
        advanced {
            htmlDomId: modern_report
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column LANGUAGE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: "&{LANGUAGE}."
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column LANGUAGE_LEVEL (
            reportColumnQueryId: 3
