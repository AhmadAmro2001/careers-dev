    region language (
        name: Language
        title: "&{LANGUAGE}."
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID as Lang_id,
                       LANGUAGE_ID,
                       LANGUAGE_LEVEL_ID,
                       PERSONAL_ID
                  from JOB_APPLICATION_LANGUAGE
                ```
        }
        layout {
            sequence: 60
            parentRegion: @educationw
            slot: wizardSubRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region navbar (
        name: navbar
        title: "&{NAVBAR}."
        type: appTemplateComponent/appliocantNavbar
        layout {
            sequence: 10
            slot: body
            column: 3
            columnSpan: 8
        }
        componentAppearance {
            display: regionOnly
        }
    )

    region personal-education (
        name: Personal_education
        title: "&{PERSONALEDUCATION}."
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- SELECT ED.ID,
                --        EduL.name as LEVEL_NAME,
                --        EduF.name as FIELD_NAME,
                --        GRADUATION_YEAR,
                --        EduG.name as GRADE_NAME,
                --        sys.dbms_lob.getlength(ED.GRADUATION_CERTIFICATE) as GRADUATION_CERTIFICATE
                -- FROM EDUCATION_DEGREE ED
                -- join EDUCATION_LEVEL EduL on EduL.id = ED.EDUCATION_LEVEL
                -- join EDUCATION_FIELD EduF on EduF.id = ED.EDUCATION_FIELD
                -- join EDUCATION_GRADE EduG on EduG.id = ED.EDUCATION_GRADE
                -- WHERE personal_id = :APP_USER_PERS_ID;
                
                
                select eduD.GRADUATION_CERTIFICATE_FILE_ID,
                       eduD.id as eduD_id,
                       j.id,
                       j.file_name,
                       dbms_lob.getlength(j.file_blob) as image,
                       eduD.GRADUATION_YEAR,
                       eduD.UNIVERSITY,
                       eduD.OTHER_EDUCATION_FIELD,
                       eduL.name as EDUCATION_LEVEL,
                       eduF.name as EDUCATION_FIELD,
                       eduG.name as EDUCATION_GRADE
                  from EDUCATION_DEGREE eduD
                  join education_level eduL on eduL.id = eduD.EDUCATION_LEVEL
                  join EDUCATION_FIELD eduF on eduF.id = eduD.EDUCATION_FIELD
                  join EDUCATION_GRADE eduG on eduG.id = eduD.EDUCATION_GRADE
                  left join job_application_attachments j
                           on j.id = eduD.GRADUATION_CERTIFICATE_FILE_ID
                  where personal_id = :APP_USER_PERS_ID;
                ```
        }
        layout {
            sequence: 30
            parentRegion: @educationw
            slot: wizardSubRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
        advanced {
            htmlDomId: modern_report
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

