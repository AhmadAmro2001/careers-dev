    dynamicAction pass-natid (
        name: pass_natId
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P119_COUNTRY_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P119_COUNTRY_ID').trim() === '' || $v('P119_COUNTRY_ID').trim() === '63';
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P119_NATIONAL_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P119_NATIONAL_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction passport-or-natid (
        name: passport_or_natID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P119_COUNTRY_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P119_COUNTRY_ID').trim() !== '' && $v('P119_COUNTRY_ID').trim() !== '63'
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P119_PASSPORT_NUMBER
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P119_PASSPORT_NUMBER
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction select-country-phone-code (
        name: select country phone code
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P119_COUNTRY_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P119_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select country.phone_code from country country where id = :P119_COUNTRY_ID;
                itemsToSubmit: P119_COUNTRY_ID
            }
            affectedElements {
                selectionType: items
                items: P119_COUNTRY_PHONE_CODE_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    validation number-validation (
        name: number_validation
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNumeric
            item: P119_HOME_TELEPHONE
        }
        error {
            errorMessage: "&{PHONE_NUMBER_MUST_BE_NUMBERS_ONLY}."
            associatedItem: @P119_HOME_TELEPHONE
        }
    )

    validation number-validation_1 (
        name: natId_validation
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: "REGEXP_LIKE(:P1_NAT_ID, '^[0-9]{14}$')"
        }
        error {
            errorMessage: "&{NATIONAL_ID_LENGTH_ERROR}."
            associatedItem: @P119_HOME_TELEPHONE
        }
    )

    process create-personal-info (
        name: Create_personal_info
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_personal_id NUMBER;
                Begin
                    user_personal_info_pkg.Save_Personal_data(:P119_MARITAL_STATUS_1, :P119_MILITARY_STATUS_1, :P119_MOTHER_FULL_NAME_1,
                    :P119_NATIONAL_ID_FILE_ID, TO_NUMBER(:APP_USER_ACC_ID), v_personal_id );
                
                    :APP_USER_PERS_ID := v_personal_id;
                
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 352641439785250641
        }
        serverSideCondition {
            whenButtonPressed: @next-pers
        }
    )

    process get-user-data-if-exist (
        name: get user data if exist
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- BEGIN
                --     IF :APP_USER_ACC_ID IS NULL THEN
                --         RAISE_APPLICATION_ERROR(-20001, 'User session expired. Please login again.');
                --     END IF;
                --     SELECT ID,
                --            first_name,
                --            second_name,
                --            last_name,
                --            date_of_birth,
                --            gender,
                --            email,
                --            home_telephone,
                --            address,
                --            city,
                --            national_id,
                --            passport_number,
                --            country_id,
                --            country_phone_code_id,
                --            mobile_telephone
                --     INTO   :P119_ID,
                --            :P119_FIRST_NAME,
                --            :P119_SECOND_NAME,
                --            :P119_LAST_NAME,
                --            :P119_DATE_OF_BIRTH,
                --            :P119_GENDER,
                --            :P119_EMAIL,
                --            :P119_HOME_TELEPHONE,
                --            :P119_ADDRESS,
                --            :P119_CITY,
                --            :P119_NATIONAL_ID,
                --            :P119_PASSPORT_NUMBER,
                --            :P119_COUNTRY_ID,
                --            :P119_COUNTRY_PHONE_CODE_ID,
                --            :P119_MOBILE_TELEPHONE
                --     FROM account
                --     WHERE id = :APP_USER_ACC_ID;
                -- END;
                
                
                BEGIN
                    IF :APP_USER_ACC_ID IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20001, 'User session expired. Please login again.');
                    END IF;
                
                    BEGIN
                        SELECT id,
                               first_name,
                               second_name,
                               last_name,
                               date_of_birth,
                               gender,
                               email,
                               home_telephone,
                               address,
                               city_id,
                               national_id,
                               passport_number,
                               country_id,
                               country_phone_code_id,
                               mobile_telephone
                        INTO   :P119_ID,
                               :P119_FIRST_NAME,
                               :P119_SECOND_NAME,
                               :P119_LAST_NAME,
                               :P119_DATE_OF_BIRTH,
                               :P119_GENDER,
                               :P119_EMAIL,
                               :P119_HOME_TELEPHONE,
                               :P119_ADDRESS,
                               :P119_CITY_ID,
                               :P119_NATIONAL_ID,
                               :P119_PASSPORT_NUMBER,
                               :P119_COUNTRY_ID,
                               :P119_COUNTRY_PHONE_CODE_ID,
                               :P119_MOBILE_TELEPHONE
                        FROM account
                        WHERE id = :APP_USER_ACC_ID;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            :P119_ID := NULL;
                            :P119_FIRST_NAME := NULL;
                            :P119_SECOND_NAME := NULL;
                            :P119_LAST_NAME := NULL;
                            :P119_DATE_OF_BIRTH := NULL;
                            :P119_GENDER := NULL;
                            :P119_EMAIL := NULL;
                            :P119_HOME_TELEPHONE := NULL;
                            :P119_ADDRESS := NULL;
                            :P119_CITY := NULL;
                            :P119_NATIONAL_ID := NULL;
                            :P119_PASSPORT_NUMBER := NULL;
                            :P119_COUNTRY_ID := NULL;
                            :P119_COUNTRY_PHONE_CODE_ID := NULL;
                            :P119_MOBILE_TELEPHONE := NULL;
                    END;
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 350601299695083868
        }
    )

    process get-user-pers-data-if-exists (
        name: get user pers data if exists
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                select p.id,p.id,p.mother_full_name, p.MILITARY_STATUS, p.MARITAL_STATUS 
                into 
                :APP_USER_PERS_ID ,:P119_Pers_id_1 ,:P119_MOTHER_FULL_NAME_1, :P119_MILITARY_STATUS_1, :P119_MARITAL_STATUS_1 
                from personal_info p 
                join MILITARY_STATUS mls on p.MILITARY_STATUS = mls.id 
                join MARITAL_STATUS ms on p.MARITAL_STATUS = ms.id
                where p.account_id = :APP_USER_ACC_ID;
                
                
                exception
                    when no_data_found then
                        :P119_MOTHER_FULL_NAME_1 := null;
                        :P119_MILITARY_STATUS_1  := null;
                        :P119_MARITAL_STATUS_1   := null;
                        :P119_PERS_ID_1 := null;
                
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 352640863437246717
        }
    )

