page 119 (
    name: "Personal Info "
    alias: PERSONAL-INFO-W
    title: "&{PERSONAL_INFO}."
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* ========================================================== */
            /* CUSTOM NAVBAR                                               */
            /* ========================================================== */
            
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            
                background: rgb(233, 233, 233);
            
                padding: 14px 24px;
            
                border-radius: 18px;
            
                box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            
                margin-bottom: 20px;
            }
            
            /* Left Links */
            .nav-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            
            /* Nav Links */
            .nav-link {
                display: flex;
                align-items: center;
                gap: 8px;
            
                text-decoration: none;
            
                color: #334155;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Hover */
            .nav-link:hover {
                background: rgb(232, 244, 255);
                color: #0563bb;
            }
            
            /* Logout Button */
            .logout-btn {
                display: flex;
                align-items: center;
                gap: 8px;
            
                background: #ef4444;
            
                color: white !important;
            
                text-decoration: none;
            
                padding: 10px 18px;
            
                border-radius: 12px;
            
                font-weight: 600;
            
                transition: all 0.3s ease;
            }
            
            /* Logout Hover */
            .logout-btn:hover {
                background: #dc2626;
                transform: translateY(-1px);
            }
            
            /* Icons */
            .custom-navbar .fa {
                font-size: 14px;
            }
            
            
            [data-header="National Id Image"] img,
            [data-header="NATIONAL_ID_IMAGE"] img {
                width: 300px !important;
                height: auto !important;
            }
            
            
            img {
                width: 250px !important;
                height: 130px !important;
                object-fit: cover;
                border-radius: 10px;
            }
            
            .nav-right {
                display: flex;
                align-items: center;
                gap: 15px;
            }
            
            .user-name {
                color: #333;
                font-weight: 600;
            }
            
            /* Make navbar wrap on small screens */
            .custom-navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap; /* مهم جداً */
            }
            
            /* Mobile & small tablets */
            @media (max-width: 768px) {
                .custom-navbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 12px;
                }
            
                .nav-left,
                .nav-right {
                    width: 100%;
                    justify-content: flex-start;
                    flex-wrap: wrap;
                }
            
                .nav-link,
                .logout-btn {
                    width: 100%;
                    justify-content: center;
                }
            
                .user-name {
                    width: 100%;
                    text-align: left;
                }
            }
            
            /* Very small screens (phones) */
            @media (max-width: 480px) {
                .nav-link,
                .logout-btn {
                    padding: 12px;
                    font-size: 14px;
                }
            
                .custom-navbar {
                    padding: 12px;
                }
            }
            
            
            
            /* ========================================================== */
            /* 1. STANDARD FORM FIELDS (TEXT, TEL, EMAIL, SELECT, ETC.)    */
            /* ========================================================== */
            
            
            
            .t-Form-fieldContainer input[type="text"],
            .t-Form-fieldContainer input[type="tel"],
            .t-Form-fieldContainer input[type="email"],
            .t-Form-fieldContainer input[type="date"],
            .t-Form-fieldContainer textarea,
            .apex-item-text,
            .apex-item-textarea {
                background-color: rgb(232, 244, 255)  !important; 
                border-radius: 10px !important; /* Consistent 10px roundness */
                border: 1px solid rgba(232, 244, 255, 0.705) !important;
                transition: all 0.3s ease !important;
            }
            
            .t-Form-fieldContainer select,
            .apex-item-select {
                background-color: rgb(232, 244, 255)  !important; 
                border-radius: 10px !important;
            }
            
            .t-Form-label::before{
                background-color: rgb(232, 244, 255)  !important; 
                border: none;
                background: transparent;
            }
            
            .t-Form-label:hover::before {
                background-color: rgb(232, 244, 255)  !important; 
            }
            
            .apex-item-file {
                border-radius: 10px !important;
                transition: all 0.3s ease !important;
            }
            .apex-item-file:hover {
                border-color: #0563bb !important;
                background-color: #f8fafc !important;
            }
            
            .apex-item-group--datepicker,
            .apex-item-group.apex-item-group--file {
                display: inline-flex !important;
                width: 100% !important;
                align-items: stretch !important;
                gap: 0 !important;
            }
            
            /* Left side of the date component (Text Field) */
            .apex-item-group--datepicker input.apex-item-text,
            input.apex-item-datepicker {
                background-color: rgb(232, 244, 255)  !important; 
                border-top-left-radius: 10px !important;
                border-bottom-left-radius: 10px !important;
                border-top-right-radius: 0px !important;
                border-bottom-right-radius: 0px !important;
                border-right: none !important; 
            }
            
            /* Right side of the date component (Calendar Button) */
            .apex-item-group--datepicker .a-Button--calendar,
            .apex-item-group--datepicker .apex-item-datepicker-btn,
            .a-Button--calendar {
                border-top-left-radius: 0px !important;
                border-bottom-left-radius: 0px !important;
                border-top-right-radius: 10px !important; /* Perfectly matches the 10px layout roundness */
                border-bottom-right-radius: 10px !important;
                border: 1px solid #cbd5e1 !important;
                border-left: 1px solid #cbd5e1 !important; 
                background-color: rgb(232, 244, 255)  !important; 
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                box-shadow: none !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region guide-message (
        name: guide message
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="grid-box-bg-blue">
                 
                    <div class="">
                        ⚠️
                    </div> 
                
                    <div class="guide-content">
                        <!-- <div class="guide-title">
                            User Guide
                        </div> -->
                
                        <p>
                            ⚠️ &{PERSONAL_INFO_ACCURACY_GUIDANCE}.
                        </p>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @personal-info-w
            slot: wizardSubRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region navbar (
        name: navbar
        title: "&{NAVBAR}."
        type: appTemplateComponent/appliocantNavbar
        layout {
            sequence: 10
            slot: body
            column: 3
            columnSpan: 8
        }
        componentAppearance {
            display: regionOnly
        }
    )

    region personal-info (
        name: Personal Info
        title: "&{PERSONAL_INFO}."
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select acc.ID,
                       acc.FIRST_NAME,
                       acc.LAST_NAME,
                       acc.DATE_OF_BIRTH,
                       acc.GENDER,
                       acc.EMAIL,
                       acc.HOME_TELEPHONE,
                       acc.ADDRESS,
                       acc.CITY,
                       acc.CITY_ID,
                       acc.NATIONAL_ID,
                       acc.SECOND_NAME,
                       acc.PASSPORT_NUMBER,
                       acc.COUNTRY_ID,
                       acc.COUNTRY_PHONE_CODE_ID,
                       acc.mobile_telephone,
                       pi.MARITAL_STATUS,
                       pi.military_status,
                       pi.mother_full_name,
                       pi.national_id_file_id,
                       pi.id as pers_id_1
                  from ACCOUNT acc
                  join personal_info pi on pi.account_id = acc.id
                ```
        }
        layout {
            sequence: 30
            parentRegion: @personal-info-w
            slot: wizardSubRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region personal-info-data (
        name: Personal Info Data
        title: "&{COMPLETE_YOUR_PERSONAL_INFO}."
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID As Pers_id,
                       ACCOUNT_ID,
                       NATIONAL_ID_IMAGE,
                       MOTHER_FULL_NAME,
                       MARITAL_STATUS,
                       MILITARY_STATUS,
                       PASSORT_NUMBER,
                       NAT_ID_FILE_NAME
                  from PERSONAL_INFO
                ```
        }
        layout {
            sequence: 40
            parentRegion: @personal-info-w
            slot: wizardSubRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region personal-info-w (
