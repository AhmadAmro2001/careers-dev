textMessage STAGE_3_FORMAT (
    message {
        text: "The interview process may include a telephonic interview with an EPROM Recruiter and/or Line Manager, followed by a face-to-face or onsite interview."
        language: en
    }
)

textMessage STAGE_3_FORMAT (
