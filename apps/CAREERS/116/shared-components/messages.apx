textMessage COLUMN_HTML_EXPRESSION (
    message {
        text:
            ```
            <div class="vacancy-card">
            
                <div class="vacancy-card-header">
                    <div>
                        <h2 class="vacancy-title">%TITLE</h2>
            
                        <div class="vacancy-sub-info">
                            <span>
                                <i class="fa fa-calendar-o"></i>
                                Posted: %POST_DATE
                            </span>
            
                            <span>
                                <i class="fa fa-user"></i>
                                By: %NAME
                            </span>
                        </div>
                    </div>
            
                    <span class="vacancy-status %STATUS_CLASS">
                        %VACANCY_STATUS
                    </span>
                </div>
            
                <div class="vacancy-info-grid">
            
                    <div class="vacancy-info-box">
                        <span class="info-label">Category</span>
                        <span class="info-value">%CATEGORY_NAME</span>
                    </div>
            
                    <div class="vacancy-info-box">
                        <span class="info-label">Minimum Education Level</span>
                        <span class="info-value">%MINIMUM_EDUCATION_LEVEL_ID</span>
                    </div>
            
                    <div class="vacancy-info-box">
                        <span class="info-label">Ministry Exclusive</span>
                        <span class="info-value">%MINISTRY_EXCLUSIVE</span>
                    </div>
            
                    <div class="vacancy-info-box">
                        <span class="info-label">Created On</span>
                        <span class="info-value">%CREATION_DATE</span>
                    </div>
            
                    <div class="vacancy-info-box">
                        <span class="info-label">Last Updated</span>
                        <span class="info-value">%LAST_UPDATE_DATE</span>
                    </div>
            
                    <div class="vacancy-info-box">
                        <span class="info-label">Updated By</span>
                        <span class="info-value">%LAST_UPDATED_BY</span>
                    </div>
            
                </div>
            
                <div class="vacancy-section">
                    <h3>
                        <i class="fa fa-info-circle"></i>
                        Job Summary
                    </h3>
            
                    <div class="vacancy-html-content">
                        %SUMMARY
                    </div>
                </div>
            
                <div class="vacancy-section">
                    <h3>
                        <i class="fa fa-tasks"></i>
                        Responsibilities
                    </h3>
            
                    <div class="vacancy-html-content">
                        %RESPONSIBILITIES
                    </div>
                </div>
            
                <div class="vacancy-section">
                    <h3>
                        <i class="fa fa-check-square-o"></i>
                        Required Qualifications
                    </h3>
            
                    <div class="vacancy-html-content">
                        %QUALIFICATIONS
                    </div>
                </div>
            
            </div>
            ```
        language: ar
    }
)

textMessage COLUMN_HTML_EXPRESSION (
    message {
        text:
            ```
            <div class="vacancy-card">
            
                <div class="vacancy-card-header">
                    <div>
