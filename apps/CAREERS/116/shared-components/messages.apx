textMessage FRAUD_ALERT_INTRO (
    message {
        text: "In our commitment to protecting citizens and maintaining our credibility, EPROM strongly warns and fully disclaims any responsibility against fake entities, individuals, online pages or phone numbers spreading misleading information falsely claiming to act as intermediaries offering job opportunities in the name of EPROM."
        language: en
    }
)

textMessage FRAUD_ALERT_INTRO (
    message {
        text: "في إطار التزامنا بحماية المواطنين والحفاظ على مصداقيتنا، تحذر إيبروم بشدة وتخلي مسؤوليتها تمامًا عن أي جهات أو أفراد أو صفحات إلكترونية أو أرقام هاتفية زائفة تنشر معلومات مضللة وتدّعي كذبًا أنها وسطاء لتوفير فرص عمل باسم إيبروم."
        language: ar
    }
)

