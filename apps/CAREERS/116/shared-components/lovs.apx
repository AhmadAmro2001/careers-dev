lov account-password (
    name: ACCOUNT.PASSWORD
    source {
        tableName: ACCOUNT
    }
    columnMapping {
        return: ID
        display: PASSWORD
        defaultSort: PASSWORD
    }
)

lov career-category-name (
    name: CAREER_CATEGORY.NAME
    source {
        tableName: CAREER_CATEGORY
    }
    columnMapping {
        return: ID
        display: NAME
        defaultSort: NAME
    }
)

lov category-name (
    name: CATEGORY_NAME
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT NAME ,ID
            FROM CAREER_CATEGORY
            ```
    }
    columnMapping {
        return: ID
        display: NAME
        defaultSort: NAME
    }
)

