lov education-with-rank (
    name: EDUCATION WITH RANK
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select name || ' - Rank : '||LEVEL_RANK ,id
            from Education_level
            order by LEVEL_RANK asc
            ```
    }
    columnMapping {
        return: ID
    }
)

lov grad-year (
    name: GRAD_YEAR
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT GRADUATION_YEAR
            FROM EDUCATION_DEGREE
            ORDER BY GRADUATION_YEAR DESC;
            ```
    }
    columnMapping {
        return: GRADUATION_YEAR
        display: GRADUATION_YEAR
    }
)

